// =====================================================================
// ITA SARL — Schéma de données — M0 (Socle)
//
// Ce fichier ne porte que les 9 modèles nécessaires à M0 (cf. décision
// confirmée avec l'utilisateur, M0-SOCLE.md §4), pas le schéma cible
// complet du produit — celui-ci reste consultable tel quel dans
// docs/schema-cible.prisma, module par module.
//
// Conventions reprises du schéma cible :
//   · Horodatages : DateTime @default(now()) en UTC
//   · Suppression : archiveLe DateTime? — jamais de DELETE physique
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connexion mutualisée (pgBouncer, port 6543) — utilisée par l'application
  url       = env("DATABASE_URL")
  // Connexion directe (port 5432) — requise par les migrations et introspect
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// PROFILS ET HABILITATIONS
//
// L'authentification est assurée par Supabase Auth : la table
// `auth.users` détient l'identité, le mot de passe et les sessions.
// Prisma ne la gère pas — elle vit dans un schéma que les migrations
// ne doivent pas toucher.
//
// `Profil.id` reprend l'UUID de `auth.users.id`. Le lien est maintenu
// par un trigger Postgres (migration écrite à la main) à la création
// du compte Supabase.
// =====================================================================

/// Rôle applicatif. Distinct du poste : un Chef Chantier peut porter
/// le rôle de saisie des relevés sans que le poste ne l'implique.
model Role {
  id          String  @id @default(cuid())
  code        String  @unique // ADMIN, DRH, RH, DT, CT, CC, CE, DFC, DG
  libelle     String
  description String?
  systeme     Boolean @default(false) // non supprimable

  permissions RolePermission[]
  profils     ProfilRole[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id      String @id @default(cuid())
  code    String @unique // employe:creer, derogation:valider, paie:validerDT…
  libelle String
  domaine String // RH, PAIE, TECHNIQUE, REFERENTIEL, ADMIN

  roles RolePermission[]

  @@index([domaine])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ProfilRole {
  profilId   String   @db.Uuid
  roleId     String
  profil     Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  attribueLe DateTime @default(now())

  @@id([profilId, roleId])
  @@map("profil_roles")
}

/// Codes de secours MFA (TOTP) — dix codes à usage unique, générés à
/// l'activation, affichés une seule fois, jamais stockés en clair.
/// Absent du schéma cible fourni, ajouté en M0 (décision confirmée
/// avec l'utilisateur) car requis par le critère de recette de la
/// double authentification.
model CodeSecoursMfa {
  id        String    @id @default(cuid())
  profilId  String    @db.Uuid
  profil    Profil    @relation(fields: [profilId], references: [id], onDelete: Cascade)
  codeHache String
  utiliseLe DateTime?
  creeLe    DateTime  @default(now())

  @@index([profilId])
  @@map("codes_secours_mfa")
}

/// Créé en M0, utilisé à partir de M2 (décision E-03).
model Brouillon {
  id String @id @default(cuid())

  profilId String @db.Uuid

  /// Type d'entité concernée : Employe, ReleveActivite, AppelOffres…
  entite   String
  /// Identifiant de l'entité en cours de modification. `null` en création.
  entiteId String?

  donnees Json

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@unique([profilId, entite, entiteId])
  @@index([modifieLe])
  @@map("brouillons")
}

/// Paramètres applicatifs typés par clé. Évite une table par famille.
model Parametre {
  id      String  @id @default(cuid())
  cle     String  @unique
  valeur  String // sérialisé, typé côté applicatif via zod
  type    String // NUMBER, STRING, BOOLEAN, JSON
  groupe  String // AO, PROJET, RELEVE, RH, PAIE
  libelle String
  aide    String?

  modifieParId String?
  modifieLe    DateTime @updatedAt

  @@index([groupe])
  @@map("parametres")
}

/// Journal d'audit transverse. Toute décision opposable y est tracée :
/// validations, refus, changements de règle, révisions de grille.
model JournalEvenement {
  id String @id @default(cuid())

  entite   String // Profil, Role, ProfilRole…
  entiteId String
  action   String // CREATION, MODIFICATION, VALIDATION, REFUS, ARCHIVAGE

  auteurId  String? @db.Uuid
  auteur    Profil? @relation(fields: [auteurId], references: [id])
  auteurNom String

  /// Différentiel avant/après, ou contexte de la décision
  details     Json?
  commentaire String?

  survenuLe DateTime @default(now())

  @@index([entite, entiteId])
  @@index([survenuLe])
  @@map("journal_evenements")
}

/// Créée en M0 pour que les modules suivants puissent y écrire
/// (décision E-05). Non exploitée par un écran de M0.
model Notification {
  id String @id @default(cuid())

  destinataireId String  @db.Uuid
  type           String // ECHEANCE_CONTRAT, JALON_RETARD, PAIE_A_CLOTURER…
  titre          String
  message        String
  lienEntite     String?
  lienEntiteId   String?

  lue   Boolean   @default(false)
  lueLe DateTime?

  /// Envoi par courriel via Resend
  emailEnvoye   Boolean   @default(false)
  emailEnvoyeLe DateTime?
  emailResendId String?

  creeLe DateTime @default(now())

  @@index([destinataireId, lue])
  @@index([emailEnvoye])
  @@map("notifications")
}

// =====================================================================
// ORGANISATION — M1
//
// Trois niveaux : Direction › Service › Poste
// Ces trois niveaux sont des TABLES et non des enums. L'organigramme
// évolue (DECISIONS.md A-01 à A-11).
// =====================================================================

enum NiveauHierarchique {
  DIRECTION
  CADRE
  SUPPORT
  OPERATIONNEL
}

// =====================================================================
// EMPLOYÉS — M2
//
// Type de main-d'œuvre : PERMANENT (dossier complet) vs JOURNALIER
// (4 champs seulement). Décision A-11, A-12.
// =====================================================================

enum TypeMainOeuvre {
  PERMANENT
  JOURNALIER
}

enum TypeContrat {
  CDI
  CDD
  INTERIM
  STAGE
}

enum SituationMatrimoniale {
  CELIBATAIRE
  MARIE
  DIVORCE
  VEUF
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum ModePaiement {
  VIREMENT
  WAVE
}

enum StatutDerogation {
  EN_ATTENTE
  VALIDEE
  REFUSEE
  SANS_OBJET // Dérogation devenue obsolète (changement de poste, nouvelle grille, etc.)
}

// =====================================================================
// M4 — RÉMUNÉRATION
// =====================================================================

enum StatutGrille {
  BROUILLON
  PUBLIEE
  ARCHIVEE
}

// =====================================================================
// M5 — PROJETS ET PLANNING
// =====================================================================

enum StatutProjet {
  BROUILLON
  OUVERT
  EN_COURS
  SUSPENDU
  CLOTURE
}

enum CyclePaie {
  JOURNALIER
  HEBDOMADAIRE
  QUINZAINE
  MENSUEL
}

enum TypeValidateur {
  INTERNE
  MAITRE_OEUVRE
  MAITRE_OUVRAGE
}

enum StatutJalon {
  ATTENTE
  VALIDE
  ABANDONNE
}

enum RoleFonctionnel {
  CONDUCTEUR
  CHARGE_ETUDES
  CHEF_CHANTIER
  CHEF_EQUIPE
}

model Direction {
  id           String  @id @default(cuid())
  code         String  @unique // DG, DFC, DT, DAR
  libelle      String
  ordre        Int     @default(0)
  reserveAdmin Boolean @default(false) // création/affectation réservée

  services Service[]
  postes   Poste[]

  /// M16 — Assistanat
  courriers Courrier[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@map("directions")
}

model Service {
  id      String @id @default(cuid())
  code    String @unique
  libelle String
  ordre   Int    @default(0)

  directionId String
  direction   Direction @relation(fields: [directionId], references: [id])

  postes Poste[]

  /// M16 — Assistanat
  courriers Courrier[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@index([directionId])
  @@map("services")
}

model Poste {
  id      String             @id @default(cuid())
  code    String             @unique
  libelle String
  niveau  NiveauHierarchique

  /// Rattachement à un service. NULL = poste transverse à la direction
  /// (ex: chaîne chantier DT, sans service spécifique)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  directionId String
  direction   Direction @relation(fields: [directionId], references: [id])

  /// Supérieur par défaut au niveau du poste. Sert à proposer
  /// automatiquement le bon supérieur lors d'une affectation.
  /// Affectation.superieurId reste le lien réel, personne par personne,
  /// et peut s'en écarter.
  superieurPosteId String?
  superieurPoste   Poste?  @relation("HierarchiePoste", fields: [superieurPosteId], references: [id])
  subordonnesPoste Poste[] @relation("HierarchiePoste")

  reserveAdmin     Boolean @default(false)
  /// Un seul titulaire actif à la fois (postes de direction)
  titulaireUnique  Boolean @default(false)
  /// Ouvre un compteur de congés annuels (DECISIONS.md)
  ouvreDroitConges Boolean @default(true)

  affectations Affectation[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@index([directionId])
  @@index([serviceId])
  @@map("postes")
}

// =====================================================================
// MODÈLES M2 — EMPLOYÉS
// =====================================================================

/// Table de référence des nationalités. Modifiable via création inline.
model Nationalite {
  id      String @id @default(cuid())
  libelle String @unique

  employes Employe[]

  @@map("nationalites")
}

// =====================================================================
// M17 — COMPÉTENCES ET TAUX JOURNALIERS
// =====================================================================

/// Catégorie de compétence. Détermine la logique de composition.
enum CategorieCompetence {
  BASE     /// Manœuvre, aide — sans qualification particulière
  QUALIFIE /// Un métier — maçon, soudeur, ferrailleur
  COMPOSEE /// Plusieurs métiers réunis
}

/// Compétence d'un journalier. Un agent porte UNE compétence.
/// S'il sait faire deux métiers, on crée une compétence composée.
model Competence {
  id String @id @default(uuid())

  /// Libellé (ex: "Maçon", "Maçon-Coffreur")
  libelle String @unique

  /// Minuscules, sans accent, sans espace superflu — détecte les doublons
  libelleNormalise String @unique

  /// Catégorie : BASE, QUALIFIE ou COMPOSEE
  categorie CategorieCompetence

  /// Auto-relation : une composée réunit plusieurs qualifiées
  composantes  Competence[] @relation("Composition")
  composeeDans Competence[] @relation("Composition")

  /// Description optionnelle
  description String?

  actif          Boolean  @default(true)
  motifArchivage String?

  creeParId String
  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  taux         TauxJournalier[]
  affectations AffectationCompetence[]

  @@index([actif, categorie])
  @@map("competences")
}

/// Taux journalier d'une compétence. Historisé : un taux ne se modifie pas,
/// il se remplace avec une nouvelle date d'effet.
model TauxJournalier {
  id String @id @default(uuid())

  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id])

  /// Montant en XOF (Franc CFA). Entier, pas de centimes.
  montant Decimal @db.Decimal(12, 0)

  /// Date à partir de laquelle ce taux s'applique
  dateEffet DateTime @db.Date

  /// Motif de la révision. Requis dès qu'un taux précédent existe.
  motif String?

  /// Direction Financière qui a fixé ce taux
  definiParId String
  definiLe    DateTime @default(now())

  @@unique([competenceId, dateEffet])
  @@index([competenceId, dateEffet])
  @@map("taux_journaliers")
}

/// Affectation d'une compétence à un employé. Historisée : permet de
/// calculer la paie d'un jour passé avec la compétence de ce jour-là.
model AffectationCompetence {
  id String @id @default(uuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id])

  /// Date à partir de laquelle cette compétence s'applique
  dateEffet DateTime @db.Date

  /// Date de fin (renseignée quand une nouvelle affectation prend le relais)
  dateFin DateTime? @db.Date

  /// Motif du changement. Requis si l'agent avait déjà une compétence.
  motif String?

  /// Direction RH qui a assigné cette compétence
  assigneeParId String
  assigneeLe    DateTime @default(now())

  @@index([employeId, dateEffet])
  @@map("affectations_competence")
}

/// Employé ITA. Deux dossiers distincts selon typeMainOeuvre :
/// - PERMANENT : dossier complet (~40 champs)
/// - JOURNALIER : 4 champs seulement (décision A-12)
model Employe {
  id String @id @default(cuid())

  /// Format ITA-AAAA-NNNN. Généré par le serveur, conservé à vie.
  matricule String @unique

  typeMainOeuvre TypeMainOeuvre

  // --- Identité (obligatoire pour tous) ---
  nom    String
  prenom String
  sexe   Sexe?

  // --- Identité (PERMANENT uniquement) ---
  dateNaissance         DateTime?              @db.Date
  lieuNaissance         String?
  nationaliteId         String?
  nationalite           Nationalite?           @relation(fields: [nationaliteId], references: [id])
  situationMatrimoniale SituationMatrimoniale?
  nombreEnfants         Int?                   @default(0)

  /// Donnée SENSIBLE. Unique parmi les permanents actifs (non archivés).
  numeroCnps String? @unique

  // --- Contact ---
  telephone           String // Obligatoire pour tous
  telephoneSecondaire String?
  email               String?
  /// Donnée SENSIBLE
  adresse             String?

  // --- Contact d'urgence (PERMANENT) ---
  urgenceNom String?
  urgenceTel String?

  // --- Paiement ---
  /// Donnée SENSIBLE. Pour JOURNALIER, obligatoire si modePaiement = WAVE.
  /// Double confirmation obligatoire. Toute modification journalisée.
  numeroWave   String?
  modePaiement ModePaiement?

  /// RIB pour permanents. Donnée SENSIBLE.
  rib String?

  // --- Référence interne (optionnel) ---
  /// Code utilisé avant ITA Manager (ex: "OP-052", "DG-001").
  referenceInterne String?

  // --- Relations ---
  affectations          Affectation[]
  contrats              Contrat[]
  documents             DocumentEmploye[]
  derogationsSalariales DerogationSalariale[]

  /// Hiérarchie employé : subordonnes directs
  subordonnesEmploye Affectation[] @relation("HierarchieEmploye")

  /// Lien vers le profil applicatif (null si l'employé n'a pas de compte)
  profil Profil?

  /// M3 — Congés et permissions
  absences           Absence[]
  soldeCongés       SoldeConge[]
  delegationsMandant Delegation[] @relation("Mandant")
  delegationsDeleg   Delegation[] @relation("Delegataire")

  /// M12 — Présences bureau
  codePointage    CodePointage?
  pointagesBureau PointageBureau[]

  /// M5 — Projets (chaîne fonctionnelle)
  affectationsChantier AffectationChantier[]
  tachesResponsable    Tache[]              @relation("TachesResponsable")
  affectationsTaches   AffectationTache[]
  projetsConducteur    Projet[]             @relation("ConducteurProjet")

  /// M6 — Relevés d'activité
  relevesChefChantier ReleveActivite[]
  pointages           Pointage[]

  /// M7 — Paie chantier
  lignesPaie LignePaie[]

  /// M14 — Achats
  demandesAchatDemandeur    DemandeAchat[] @relation("DemandesDemandeur")
  demandesAchatBeneficiaire DemandeAchat[] @relation("DemandesBeneficiaire")

  /// M13 L3 — Transport
  demandesTransportChauffeur DemandeTransport[] @relation("chauffeur")

  /// M16 — Assistanat
  visitesRecues              Visite[]                @relation("VisitesRecues")
  distributionsCarburant DistributionCarburant[] @relation("DistributionsCarburantDemandees")

  /// M17 — Compétences (JOURNALIER uniquement)
  competences AffectationCompetence[]

  /// M19 — Missions et frais de mission
  missions Mission[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  /// Archivage, jamais suppression. Motif stocké dans JournalEvenement.
  archiveLe DateTime?

  @@index([matricule])
  @@index([typeMainOeuvre])
  @@index([nationaliteId])
  @@index([archiveLe, typeMainOeuvre]) // M20260808 — Optimise requêtes employés actifs par type
  @@map("employes")
}

/// Promouvoir Profil.employeId en vraie relation
model Profil {
  /// UUID identique à auth.users.id (Supabase)
  id String @id @db.Uuid

  email        String    @unique
  actif        Boolean   @default(true)
  derniereConn DateTime?

  /// Rattachement à un employé. `null` pour les comptes techniques
  /// (ex. Super Admin, hors organigramme).
  employeId String?  @unique
  employe   Employe? @relation(fields: [employeId], references: [id])

  /// Délégation de pouvoir (décision B-03)
  delegataireId   String?   @db.Uuid
  delegationDebut DateTime? @db.Date
  delegationFin   DateTime? @db.Date

  roles           ProfilRole[]
  evenements      JournalEvenement[]
  codesSecoursMfa CodeSecoursMfa[]

  /// M15 — Relations paiements
  demandesPaiement       DemandePaiement[]      @relation("PreparateurPaiement")
  autorisationsDemandees AutorisationPaiement[] @relation("DemandeurAutorisation")
  autorisationsAccordees AutorisationPaiement[] @relation("AutorisateurPaiement")

  /// M13 L3 — Relations transport
  demandesTransport DemandeTransport[] @relation("demandesTransport")

  /// M16 — Assistanat
  visitesSaisies   Visite[]
  courriersSaisis  Courrier[] @relation("CourriersSaisis")
  courriersTraites Courrier[] @relation("CourriersTraites")

  /// M19 — Missions et frais de mission
  missionsVisees            Mission[]            @relation("VisaMission")
  missionsValideesRh        Mission[]            @relation("ValidationRhMission")
  missionsCloturees         Mission[]            @relation("ClotureMission")
  missionsRefusees          Mission[]            @relation("RefusMission")
  missionsAnnulees          Mission[]            @relation("AnnulationMission")
  lignesFraisAcceptees      LigneFrais[]         @relation("ControlefraisMission")
  lignesFraisRejetees       LigneFrais[]         @relation("RejetFraisMission")
  versementsAvanceEffectues VersementAvance[]    @relation("VersementAvanceMission")
  regularisationsApurees    Regularisation[]     @relation("ApurementMission")

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@map("profils")
}

/// Affectation d'un employé à un poste. Un employé peut avoir plusieurs
/// affectations successives (historique). Une seule active à la fois.
model Affectation {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  posteId String
  poste   Poste  @relation(fields: [posteId], references: [id])

  /// Supérieur hiérarchique RÉEL (personne par personne).
  /// Proposé depuis Poste.superieurPosteId, mais modifiable.
  /// Obligatoire sauf pour le Directeur Général (décision B-09).
  superieurId String?
  superieur   Employe? @relation("HierarchieEmploye", fields: [superieurId], references: [id])

  dateDebut DateTime  @db.Date
  dateFin   DateTime? @db.Date

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([employeId])
  @@index([posteId])
  @@index([superieurId])
  @@index([dateFin]) // M20260808 — Optimise recherche affectations actives
  @@map("affectations")
}

/// Contrat de travail. Jamais modifié après signature : toute modification
/// donne lieu à un Avenant (historique lisible).
model Contrat {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  typeContrat TypeContrat
  dateDebut   DateTime    @db.Date
  /// Obligatoire pour CDD et STAGE, null pour CDI et INTERIM
  dateFin     DateTime?   @db.Date

  /// Salaire mensuel brut (PERMANENT) ou taux journalier (JOURNALIER).
  /// Donnée SENSIBLE. Si hors grille, déclenche DerogationSalariale.
  salaire Decimal @db.Decimal(10, 2)

  /// Contrat signé déposé dans DocumentEmploye
  signe Boolean @default(false)

  avenants Avenant[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([employeId])
  @@index([typeContrat])
  @@index([dateFin]) // Pour alertes CDD
  @@map("contrats")
}

/// Avenant à un contrat (changement de poste, salaire, durée).
/// Jamais de réécriture du contrat : l'historique doit rester lisible.
model Avenant {
  id String @id @default(cuid())

  contratId String
  contrat   Contrat @relation(fields: [contratId], references: [id])

  motif           String // "Changement de poste", "Augmentation salariale"
  dateEffet       DateTime  @db.Date
  nouveauSalaire  Decimal?  @db.Decimal(10, 2)
  nouvelleDateFin DateTime? @db.Date

  creeLe DateTime @default(now())

  @@index([contratId])
  @@map("avenants")
}

/// Document justificatif (pièce d'identité, diplôme, etc.).
/// Stocké dans Supabase Storage (bucket privé). Accès par URL signée courte.
model DocumentEmploye {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// Type de document : PIECE_IDENTITE, EXTRAIT_NAISSANCE, DIPLOME,
  /// CERTIFICAT_TRAVAIL, ATTESTATION_CNPS, VISITE_MEDICALE, CONTRAT_SIGNE, PHOTO
  typeDocument String

  /// Nom original du fichier
  nomFichier    String
  /// Chemin dans le bucket Supabase Storage
  cheminStorage String

  /// Taille en octets
  taille Int

  /// Les pièces médicales sont de classification PARTICULIER.
  /// Accès restreint à la DRH, consultation journalisée.
  estMedical Boolean @default(false)

  deposeParId String   @db.Uuid
  deposeLe    DateTime @default(now())

  @@index([employeId])
  @@index([typeDocument])
  @@map("documents_employes")
}

/// Dérogation salariale (salaire hors de la fourchette du niveau).
/// Circuit de validation : RH demande → DFC statue.
/// Tant que EN_ATTENTE, l'employé est exclu des exports de paie.
model DerogationSalariale {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  montant   Decimal @db.Decimal(10, 2)
  /// Fourchette du niveau au moment de la demande
  niveauMin Decimal @db.Decimal(10, 2)
  niveauMax Decimal @db.Decimal(10, 2)

  /// Motif substantiel (≥ 40 caractères). Ex: "Recrutement en tension,
  /// seul candidat titulaire du CACES 4 et de l'habilitation soudure PE."
  motif String @db.Text

  statut StatutDerogation @default(EN_ATTENTE)

  demandeParId String   @db.Uuid
  demandeLe    DateTime @default(now())

  /// Décision de la Direction Financière
  decideParId String?   @db.Uuid
  decideLe    DateTime?
  commentaire String?   @db.Text

  @@index([employeId])
  @@index([statut])
  @@map("derogations_salariales")
}

// =====================================================================
// CONGÉS ET PERMISSIONS — M3
// =====================================================================

enum StatutAbsence {
  BROUILLON // Demande en cours de rédaction
  ATTENTE_N1 // Soumise, en attente de décision du supérieur
  ATTENTE_RH // Validée par N+1, en attente de décision RH
  VALIDEE // Validée par RH, absence accordée
  REFUSEE // Refusée (soit par N+1, soit par RH)
  ANNULEE // Annulée par le demandeur ou RH
}

enum TypeMouvementSolde {
  DOTATION // Dotation annuelle ou mensuelle acquise
  MAJORATION // Majoration d'ancienneté
  REPORT // Report du solde de l'exercice précédent
  CONSOMMATION // Jours pris pour une absence validée
}

/// Types d'absence référentiels. 4 types de base créés au seed.
model TypeAbsence {
  id String @id @default(cuid())

  /// Ex: "Congé annuel", "Congé maladie", "Permission exceptionnelle"
  libelle String @unique

  /// Si true, les jours sont décomptés du solde de congés
  decompte Boolean @default(true)

  /// Si true, une pièce justificative est requise
  pieceRequise Boolean @default(false)

  /// Si true, la pièce est de classification PARTICULIER (accès DRH seule)
  /// Utilisé pour les certificats médicaux.
  pieceClassification Boolean @default(false)

  actif Boolean @default(true)

  absences Absence[]

  @@map("types_absence")
}

/// Demande d'absence (congé ou permission). Circuit à 2 étapes.
model Absence {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  typeAbsenceId String
  typeAbsence   TypeAbsence @relation(fields: [typeAbsenceId], references: [id])

  /// Bornes incluses
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date

  /// Calculé (jamais saisi) — exclut fériés et non-ouvrables
  nombreJours Decimal @db.Decimal(5, 1)

  statut StatutAbsence @default(BROUILLON)

  /// Motif de la demande (facultatif)
  motif String? @db.Text

  /// FIGÉ À LA SOUMISSION (décision 7.2)
  /// Si l'employé change de service, la demande reste chez ce supérieur.
  superieurId String?

  /// Décision du supérieur (N+1)
  decisionN1      String? // "VALIDE" | "REFUSE"
  decisionN1Le    DateTime?
  decisionN1ParId String?   @db.Uuid
  motifRefusN1    String?   @db.Text

  /// Décision de la Direction RH
  decisionRH      String? // "VALIDE" | "REFUSE"
  decisionRHLe    DateTime?
  decisionRHParId String?   @db.Uuid
  motifRefusRH    String?   @db.Text

  /// Pièce justificative (certificat médical, convocation, etc.)
  /// Référence vers DocumentEmploye.
  pieceId String?

  creeLe    DateTime  @default(now())
  soumieLe  DateTime?
  annuleeLe DateTime?

  @@index([employeId])
  @@index([statut])
  @@index([superieurId])
  @@map("absences")
}

/// Mouvements de solde de congés (JAMAIS un total stocké — voir §6.1).
/// Le solde se calcule en sommant les mouvements.
model SoldeConge {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// Exercice concerné (année civile)
  exercice Int

  typeMouvement TypeMouvementSolde

  /// Nombre de jours (positif pour dotation/majoration/report, négatif pour consommation)
  jours Decimal @db.Decimal(5, 1)

  /// Référence vers l'absence si typeMouvement = CONSOMMATION
  absenceId String?

  /// Commentaire libre (ex: "Dotation 2026", "Majoration 10 ans ancienneté")
  commentaire String?

  enregistreLe    DateTime @default(now())
  enregistreParId String   @db.Uuid

  @@index([employeId])
  @@index([exercice])
  @@map("soldes_conges")
}

/// Délégation nommée (décision B-03). Un responsable désigne son délégataire
/// à l'avance pour une période. Pendant celle-ci, les demandes lui parviennent aussi.
model Delegation {
  id String @id @default(cuid())

  /// Le mandant (celui qui délègue)
  mandantId String
  mandant   Employe @relation("Mandant", fields: [mandantId], references: [id])

  /// Le délégataire (celui qui reçoit la délégation)
  delegataireId String
  delegataire   Employe @relation("Delegataire", fields: [delegataireId], references: [id])

  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date

  /// Si false, la délégation est suspendue sans être supprimée
  actif Boolean @default(true)

  creeLe DateTime @default(now())

  @@index([mandantId])
  @@index([delegataireId])
  @@index([actif])
  @@map("delegations")
}

/// Paramètres des règles de congés (dotation, report, etc.).
/// Clé-valeur pour flexibilité. Modifiable uniquement par ADMIN.
model RegleConge {
  id String @id @default(cuid())

  /// Ex: "dotation.annuelle", "report.plafond", "majoration.10ans"
  cle String @unique

  /// Valeur stockée sous forme texte (à parser selon la clé)
  valeur String

  /// Description affichée dans l'interface d'administration
  description String? @db.Text

  modifieLe    DateTime @default(now())
  modifieParId String   @db.Uuid

  @@map("regles_conges")
}

/// Jours fériés. Fixes (ex: 1er mai) ou mobiles (ex: Aïd el-Fitr).
/// Les fériés musulmans suivent le calendrier lunaire et doivent être
/// saisis manuellement chaque année (voir §1.3).
model JourFerie {
  id String @id @default(cuid())

  date    DateTime @db.Date
  libelle String

  /// Si true, date mobile (calculée ou saisie chaque année)
  mobile Boolean @default(false)

  creeLe DateTime @default(now())

  @@unique([date])
  @@index([date])
  @@map("jours_feries")
}

// =====================================================================
// APPELS D'OFFRES — M9
// =====================================================================

enum StatutAppelOffres {
  VEILLE // Repéré, pas encore arbitré
  GO // DG a validé la participation
  ABANDONNE // No-go ou dépassé sans soumission
  CONSTITUTION // Dossier en cours de constitution
  SOUMIS // Déposé
  GAGNE // Attributaire
  PERDU // Concurrent attributaire
}

enum TypeMarche {
  PUBLIC
  PRIVE
  INTERNATIONAL
}

model AppelOffres {
  id String @id @default(cuid())

  reference       String // Référence de l'AO
  maitreOuvrage   String // Nom du maître d'ouvrage
  objet           String     @db.Text
  montantEstime   Decimal?   @db.Decimal(15, 2)
  dateLimiteDepot DateTime
  lieu            String?
  typeMarche      TypeMarche @default(PUBLIC)

  statut StatutAppelOffres @default(VEILLE)

  /// Go/No-go du Directeur Général
  goNoGoDecidePar String?   @db.Uuid
  goNoGoDecideLe  DateTime?
  goNoGoMotif     String?   @db.Text

  /// Résultat
  montantAttribution Decimal?  @db.Decimal(15, 2)
  attributaire       String? // Nom du concurrent si perdu
  dateNotification   DateTime?

  /// Relations
  pieces      PieceAO[]
  concurrents ConcurrentAO[]

  creePar   String   @db.Uuid
  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([statut])
  @@index([dateLimiteDepot])
  @@map("appels_offres")
}

model PieceAO {
  id            String      @id @default(cuid())
  appelOffresId String
  appelOffres   AppelOffres @relation(fields: [appelOffresId], references: [id], onDelete: Cascade)

  libelle     String
  obligatoire Boolean   @default(false)
  fichierUrl  String?
  deposeLe    DateTime?

  @@index([appelOffresId])
  @@map("pieces_ao")
}

model ConcurrentAO {
  id            String      @id @default(cuid())
  appelOffresId String
  appelOffres   AppelOffres @relation(fields: [appelOffresId], references: [id], onDelete: Cascade)

  nom           String
  montantSoumis Decimal? @db.Decimal(15, 2)
  remarque      String?  @db.Text

  @@index([appelOffresId])
  @@map("concurrents_ao")
}

// =====================================================================
// MODÈLES M12 — PRÉSENCES BUREAU
// =====================================================================

/// Appareil autorisé à accéder à la borne de pointage.
/// Jeton unique, généré à l'installation, révocable depuis l'administration.
model AppareilBorne {
  id String @id @default(cuid())

  /// Jeton secret unique, généré à la création, haché en base.
  /// Présenté par l'appareil à chaque requête à /borne.
  jetonHash String @unique

  libelle     String // Ex: "Tablette accueil - Rez-de-chaussée"
  emplacement String? // Ex: "Accueil principal"

  actif        Boolean   @default(true)
  dernierAcces DateTime?

  creePar    String    @db.Uuid
  creeLe     DateTime  @default(now())
  revoqueLe  DateTime?
  revoquePar String?   @db.Uuid

  @@map("appareils_borne")
}

/// Code de pointage à 5 chiffres pour un employé.
/// Haché en base, jamais stocké en clair.
/// Distinct du mot de passe applicatif.
model CodePointage {
  id        String @id @default(cuid())
  employeId String @unique

  employe Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  /// Code haché (bcrypt). Le code en clair n'est jamais stocké.
  codeHash String

  /// Régénération : l'ancien code devient invalide.
  genereParId String   @db.Uuid
  genereLe    DateTime @default(now())

  @@index([employeId])
  @@map("codes_pointage")
}

enum TypePointage {
  ARRIVEE
  DEPART
}

/// Pointage bureau d'un employé.
/// Append-only : une correction ajoute une ligne, ne modifie pas l'existante.
model PointageBureau {
  id        String @id @default(cuid())
  employeId String

  employe Employe @relation(fields: [employeId], references: [id])

  type       TypePointage
  horodatage DateTime     @default(now())

  /// Si correction manuelle par DRH
  estCorrection Boolean @default(false)
  corrigePar    String? @db.Uuid
  motif         String? @db.Text

  /// Anomalie : 3e pointage le même jour
  estAnomalie Boolean @default(false)

  @@index([employeId])
  @@index([horodatage])
  @@map("pointages_bureau")
}

// ====================================================================
// M4 — RÉMUNÉRATION
// ====================================================================

/// Version de la grille salariale — immuable une fois publiée
model GrilleSalariale {
  id String @id @default(cuid())

  /// V1, V2, V3…
  version Int

  /// BROUILLON, PUBLIEE, ARCHIVEE
  statut StatutGrille @default(BROUILLON)

  /// Date d'effet — première paie concernée
  /// Ex: v2 votée le 15 mars, dateEffet = 2026-04-01 → appliquée à la paie d'avril
  dateEffet DateTime?

  /// Date de vote DFC — obligatoire pour publier
  valideLe  DateTime?
  validePar String?   @db.Uuid

  echelons EchelonGrille[]

  creeLe  DateTime @default(now())
  creePar String   @db.Uuid

  @@unique([version])
  @@map("grilles_salariales")
}

/// Échelon dans une version de grille (un par niveau hiérarchique)
model EchelonGrille {
  id String @id @default(cuid())

  grilleId String
  grille   GrilleSalariale @relation(fields: [grilleId], references: [id], onDelete: Cascade)

  /// DIRECTION, CADRE, SUPPORT, OPERATIONNEL
  niveau NiveauHierarchique

  /// Fourchette en FCFA
  min Decimal @db.Decimal(12, 0)
  med Decimal @db.Decimal(12, 0)
  max Decimal @db.Decimal(12, 0)

  @@unique([grilleId, niveau])
  @@map("echelons_grille")
}

// ====================================================================
// M5 — PROJETS ET PLANNING
// ====================================================================

/// Projet (chantier)
model Projet {
  id String @id @default(cuid())

  /// Code unique: CH-AAAA-NNN (ex: CH-2026-001)
  code        String  @unique
  nom         String
  description String?

  /// BROUILLON, OUVERT, EN_COURS, SUSPENDU, CLOTURE
  statut StatutProjet @default(BROUILLON)

  /// Maitre d'ouvrage
  maitreOuvrage String?

  /// Montant du marché en FCFA
  montantMarche Decimal? @db.Decimal(15, 2)

  /// Dates prévisionnelles
  dateDebut DateTime?
  dateFin   DateTime?

  /// Cycle de paie pour les journaliers sur ce projet
  /// HEBDOMADAIRE, QUINZAINE, MENSUEL
  /// Figé après la première période de paie
  cyclePaie CyclePaie?

  /// Conducteur de travaux responsable du projet
  conducteurId String?
  conducteur   Employe? @relation("ConducteurProjet", fields: [conducteurId], references: [id])

  /// Relations
  taches               Tache[]
  jalons               Jalon[]
  affectations         AffectationChantier[]
  lieuLivraison        LieuLivraison?
  releves              ReleveActivite[]
  periodesPaie         PeriodePaie[]
  affectationsMateriel AffectationMateriel[]
  demandesRessource    DemandeRessource[]

  /// M13 L1 — Lieux de stockage sur ce projet (si nature=CHANTIER)
  lieuxStockage LieuStockage[]

  /// M19 — Missions rattachées à ce projet
  missions Mission[]

  creeLe  DateTime @default(now())
  creePar String   @db.Uuid

  @@map("projets")
}

/// Tâche dans un projet (pour Gantt)
model Tache {
  id String @id @default(cuid())

  projetId String
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  libelle     String
  description String?

  dateDebut DateTime
  dateFin   DateTime

  /// Avancement planifié (0-100)
  avancementPlanifie Int @default(0)

  /// Avancement constaté depuis relevés (0-100)
  avancementConstate Int?

  /// Responsable principal de la tâche
  responsableId String?
  responsable   Employe? @relation("TachesResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  /// Tâche prédécesseur (dépendance)
  predecesseurId String?
  predecesseur   Tache?  @relation("Dependances", fields: [predecesseurId], references: [id], onDelete: SetNull)
  successeurs    Tache[] @relation("Dependances")

  /// Employés assignés à cette tâche (Many-to-Many)
  affectations AffectationTache[]

  /// M6 — Travaux réalisés
  travauxRealises TravauxRealises[]

  creeLe DateTime @default(now())

  @@map("taches")
}

/// Jalon (milestone) - validé en interne ou par tiers externe
model Jalon {
  id String @id @default(cuid())

  projetId String
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  libelle            String
  description        String?
  datePrevisionnelle DateTime

  /// INTERNE (DT/DG), MAITRE_OEUVRE, MAITRE_OUVRAGE
  typeValidateur TypeValidateur

  /// Nom du validateur externe si applicable
  validateurExterne String?

  /// ATTENTE, VALIDE, ABANDONNE
  statut StatutJalon @default(ATTENTE)

  /// Pièce justificative obligatoire pour validation externe
  pieceId  String?         @unique @db.Uuid
  document DocumentJalon?

  valideLe  DateTime?
  /// Auteur de la saisie (distinct du validateur externe)
  validePar String?   @db.Uuid

  creeLe DateTime @default(now())

  @@map("jalons")
}

/// Document justificatif attaché à un jalon (PV de réception, rapport de validation, etc.)
/// Stocké dans Supabase Storage (bucket privé). Accès par URL signée courte.
model DocumentJalon {
  id String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))

  jalonId String @unique @db.Uuid
  jalon   Jalon  @relation(fields: [jalonId], references: [pieceId], onDelete: Cascade)

  /// Nom original du fichier
  nomFichier    String
  /// Chemin dans le bucket Supabase Storage
  cheminStorage String

  /// Taille en octets
  taille Int

  /// Type MIME (application/pdf, image/jpeg, etc.)
  typeMime String

  deposeParId String   @db.Uuid
  deposeLe    DateTime @default(now())

  @@map("documents_jalons")
}

/// Assignation d'un employé à une tâche (Many-to-Many)
model AffectationTache {
  id String @id @default(cuid())

  tacheId String
  tache   Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  creeLe DateTime @default(now())

  @@unique([tacheId, employeId])
  @@map("affectations_taches")
}

/// Affectation d'employé à un chantier (chaîne fonctionnelle)
/// DISTINCT de Affectation (chaîne hiérarchique)
model AffectationChantier {
  id String @id @default(cuid())

  projetId String
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// Rôle sur le chantier: CONDUCTEUR, CHEF_CHANTIER, CHEF_EQUIPE, OPERATEUR
  roleFonctionnel RoleFonctionnel

  dateDebut DateTime
  dateFin   DateTime?

  creeLe  DateTime @default(now())
  creePar String   @db.Uuid

  @@map("affectations_chantier")
}

/// Lieu de livraison — créé automatiquement à l'ouverture du projet
model LieuLivraison {
  id String @id @default(cuid())

  /// Lien 1:1 avec Projet
  projetId String? @unique
  projet   Projet? @relation(fields: [projetId], references: [id])

  libelle     String
  adresse     String?
  coordonnees String? /// GPS ou autre

  creeLe  DateTime @default(now())
  creePar String   @db.Uuid

  @@map("lieux_livraison")
}

// ============================================================================
// M6 — RELEVÉS D'ACTIVITÉ
// ============================================================================

/// Statut du relevé d'activité
enum StatutReleve {
  BROUILLON
  SOUMIS
  VISE
  REFUSE
}

/// État du pointage d'un agent
enum EtatPointage {
  PRESENT
  ABSENT_JUSTIFIE
  ABSENT_NON_JUSTIFIE
  RETARD
  REPOS
}

/// Relevé d'activité quotidien d'un chantier
/// M6 §8.1 : Un relevé par chantier et par jour (contrainte d'unicité)
model ReleveActivite {
  id String @id @default(cuid())

  /// UUID client pour déduplication sync offline (M6 §3.3)
  clientIdOffline String? @unique

  /// Date du relevé (YYYY-MM-DD)
  date DateTime @db.Date

  /// Chantier concerné
  projetId String
  projet   Projet @relation(fields: [projetId], references: [id])

  /// Chef de chantier qui saisit
  chefChantier   Employe @relation(fields: [chefChantierId], references: [id])
  chefChantierId String

  /// Statut : BROUILLON → SOUMIS → VISE / REFUSE
  statut StatutReleve @default(BROUILLON)

  /// Si refusé, motif obligatoire (M6 §1.3)
  motifRefus String?

  /// Conducteur qui vise (ou refuse)
  conducteurId String?   @db.Uuid
  viseLe       DateTime?

  /// Blocs du relevé
  pointages            Pointage[]
  travauxRealises      TravauxRealises[]
  utilisationsMateriel UtilisationMateriel[]
  consommations        ConsommationMateriau[]
  incidents            Incident[]

  /// Synchronisation hors ligne
  /// M6 §3.3 : brouillon local d'abord, synchronisation différée
  derniereSyncLocale DateTime?
  derniereSync       DateTime?
  syncEnAttente      Boolean   @default(false)

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  /// Contrainte M6 §8.1 : un seul relevé par chantier et par jour
  @@unique([projetId, date])
  @@index([chefChantierId])
  @@index([statut])
  @@index([date])
  @@map("releves_activite")
}

/// Pointage d'un agent sur un relevé
/// M6 §3.2 : Pointage par exception, tous présents par défaut
model Pointage {
  id String @id @default(cuid())

  releveId String
  releve   ReleveActivite @relation(fields: [releveId], references: [id], onDelete: Cascade)

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// État : PRESENT par défaut (M6 §3.2)
  etat EtatPointage @default(PRESENT)

  /// Heures préremplies avec les heures théoriques du jour
  heuresTheoretiques Decimal @db.Decimal(5, 2)
  heuresReelles      Decimal @db.Decimal(5, 2)
  heuresSup          Decimal @default(0) @db.Decimal(5, 2)

  /// Observation facultative
  observation String?

  /// Un seul pointage par employé par relevé
  @@unique([releveId, employeId])
  @@map("pointages")
}

/// Travaux réalisés dans la journée
/// Alimente Tache.avancementConstate (M6 §8.4)
model TravauxRealises {
  id String @id @default(cuid())

  releveId String
  releve   ReleveActivite @relation(fields: [releveId], references: [id], onDelete: Cascade)

  tacheId String?
  tache   Tache?  @relation(fields: [tacheId], references: [id])

  /// Si pas de tâche liée, description libre
  description String

  /// Avancement déclaré (%)
  avancementDeclare Decimal? @db.Decimal(5, 2)

  /// Observation du chef de chantier
  observation String?

  @@map("travaux_realises")
}

/// Utilisation de matériel (engins)
/// M6 §8.5 : Enregistrer pour analyser plus tard
model UtilisationMateriel {
  id String @id @default(cuid())

  releveId String
  releve   ReleveActivite @relation(fields: [releveId], references: [id], onDelete: Cascade)

  /// Référence au matériel (M8 - à créer)
  /// Pour l'instant, description libre
  materielDescription String

  /// Heures de fonctionnement
  heuresFonctionnement Decimal? @db.Decimal(6, 2)

  /// Carburant consommé (litres)
  carburant Decimal? @db.Decimal(8, 2)

  observation String?

  @@map("utilisations_materiel")
}

/// Consommation de matériaux
model ConsommationMateriau {
  id String @id @default(cuid())

  releveId String
  releve   ReleveActivite @relation(fields: [releveId], references: [id], onDelete: Cascade)

  /// Article (M8 - à créer)
  /// Pour l'instant, description libre
  articleDescription String

  /// Quantité et unité
  quantite Decimal @db.Decimal(10, 3)
  unite    String /// m³, tonnes, unités, etc.

  observation String?

  @@map("consommations_materiaux")
}

/// Incident sur le chantier
model Incident {
  id String @id @default(cuid())

  releveId String
  releve   ReleveActivite @relation(fields: [releveId], references: [id], onDelete: Cascade)

  /// Nature de l'incident
  nature String

  /// Description détaillée
  description String

  /// Photo (pièce jointe)
  pieceId String?

  /// M6 §8.6 : Si blessure, classification PARTICULIER
  contientBlessure Boolean @default(false)

  creeLe DateTime @default(now())

  @@map("incidents")
}

// =====================================================================
// M7 — PAIE CHANTIER
// =====================================================================

enum TypeEvenementPeriodePaie {
  OUVERTURE
  VALIDATION_RH
  VALIDATION_DT
  VALIDATION_DFC
  REFUS
  EXPORT
  CLOTURE
  ANNULATION
}

enum MoyenPaiement {
  VIREMENT
  WAVE
}

/**
 * Période de paie pour un chantier
 * M7 §3 : Circuit de validation à 3 niveaux (RH → DT → DFC)
 * M7 §8.4 : Clôturée = immuable
 * M7 §8.5 : Pas de chevauchement sur même chantier
 */
model PeriodePaie {
  id String @id @default(cuid())

  /// Chantier et période
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id])
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date

  /// Ouverture
  ouvertParId String   @db.Uuid
  ouvertLe    DateTime @default(now())

  /// Lignes de paie
  lignes LignePaie[]

  /// M7 §5.1 : Historique du circuit (statut déduit du dernier événement)
  evenements EvenementPeriodePaie[]

  /// Exports
  exports ExportPaie[]

  /// Montants totaux (calculés)
  montantBrutTotal Decimal @default(0) @db.Decimal(12, 2)
  montantNetTotal  Decimal @default(0) @db.Decimal(12, 2)

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  /// M7 §8.5 : Contrainte basique (chevauchement complet détecté en logique métier)
  @@index([projetId])
  @@index([ouvertParId])
  @@index([dateDebut])
  @@index([dateFin])
  @@map("periodes_paie")
}

/**
 * Ligne de paie individuelle
 * M7 §5.2 : Toutes les données figées au calcul
 */
model LignePaie {
  id String @id @default(cuid())

  periodeId String
  periode   PeriodePaie @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  /// Employé
  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// M7 §5.2 : Copies figées au calcul (l'employé peut changer de poste ensuite)
  nomEmploye   String
  posteLibelle String

  /// Calculs
  tauxJournalier Decimal @db.Decimal(10, 2)
  joursPointes   Decimal @db.Decimal(5, 2)
  heuresSupp     Decimal @default(0) @db.Decimal(5, 2)
  montantBrut    Decimal @db.Decimal(10, 2)
  retenues       Decimal @default(0) @db.Decimal(10, 2)
  montantNet     Decimal @db.Decimal(10, 2)

  /// M7 §5.2 : Moyen de paiement figé (RIB ou numéro Wave)
  moyenPaiement     MoyenPaiement
  compteDestination String

  /// Anomalies détectées (M7 §4.2)
  signalZeroJour       Boolean @default(false)
  signalDerogation     Boolean @default(false)
  signalEcartImportant Boolean @default(false)
  commentaireSignal    String?

  creeLe DateTime @default(now())

  @@unique([periodeId, employeId])
  @@index([employeId])
  @@map("lignes_paie")
}

/**
 * Événement du circuit de validation
 * M7 §5.1 : Le statut courant se déduit du dernier événement
 */
model EvenementPeriodePaie {
  id String @id @default(cuid())

  periodeId String
  periode   PeriodePaie @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  type TypeEvenementPeriodePaie

  /// Auteur (profil UUID)
  auteurId  String @db.Uuid
  auteurNom String

  /// Contexte
  commentaire String?
  motifRefus  String?

  creeLe DateTime @default(now())

  @@index([periodeId])
  @@index([type])
  @@map("evenements_periode_paie")
}

/**
 * Trace d'export de paie
 * M7 §8.7 : Chaque génération tracée avec condensat
 */
model ExportPaie {
  id String @id @default(cuid())

  periodeId String
  periode   PeriodePaie @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  /// Type d'export
  typeExport String /// VIREMENT_BANQUE, WAVE, COMPTABILITE

  /// Traçabilité
  genereParId  String   @db.Uuid
  genereParNom String
  genereLe     DateTime @default(now())

  /// Contenu
  fichierNom   String
  fichierUrl   String? /// URL Supabase Storage
  condensat    String /// SHA-256 du fichier
  montantTotal Decimal @db.Decimal(12, 2)
  nombreLignes Int

  @@index([periodeId])
  @@map("exports_paie")
}

// =====================================================================
// M8 — RESSOURCES ET MATÉRIEL (demandes)
// M13 — LOGISTIQUE ET PARC (matériel, pièces administratives)
// =====================================================================

/// M13 L1 — Type de matériel individuel (6 types)
enum TypeMateriel {
  VEHICULE_LEGER
  VEHICULE_LOURD
  ENGIN
  PETIT_MATERIEL
  CONTENEUR
  MOBILIER
}

/// M13 L1 — Statut opérationnel du matériel
enum StatutMateriel {
  DISPONIBLE // Au garage, libre
  EN_MISSION // Affecté à un chantier
  DEMOBILISE // Revenu de chantier, attend réaffectation
  EN_MAINTENANCE // En réparation
  EN_PANNE // Cassé
  HORS_SERVICE // Inutilisable définitivement
  REFORME // Hors circuit
}

/// M13 L1 — Nature de lieu de stockage
enum NatureLieu {
  SITE // Siège social
  CHANTIER // Projet actif (pointe vers Projet)
  GARAGE // Garage central
  MAGASIN // Magasin de stockage
  BUREAU // Bureau régional
}

enum NatureDemandeRessource {
  HUMAINE
  MATERIELLE
}

enum StatutDemandeRessource {
  BROUILLON
  SOUMISE
  VALIDEE_N1
  VALIDEE_SERVICE
  AFFECTEE
  REFUSEE
  ANNULEE
}

/**
 * M13 L1 — Famille de matériel (remplace CategorieMateriel M8)
 * Référentiel créable inline (R-04). 21 familles au seed initial.
 */
model FamilleMateriel {
  id               String       @id @default(cuid())
  code             String       @unique // AK-PICK, AK-VL, AK-BUL
  libelle          String       @unique
  libelleNormalise String       @unique // Création inline sans doublon
  type             TypeMateriel
  actif            Boolean      @default(true)

  // Format de code (décision 1.1 — format flexible)
  // Jetons : {FAMILLE} {SEQ:n} {ANNEE}
  formatCode     String @default("{FAMILLE}{SEQ:3}")
  prochainNumero Int    @default(1)

  materiel Materiel[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@map("familles_materiel")
}

/**
 * M13 L1 — Lieu de stockage (garage, chantier, magasin)
 * DISTINCT de LieuLivraison (M5) — cycles de vie différents
 */
model LieuStockage {
  id      String     @id @default(cuid())
  libelle String     @unique
  nature  NatureLieu

  /// Si nature=CHANTIER, pointe vers le projet
  projetId String?
  projet   Projet? @relation(fields: [projetId], references: [id])

  actif Boolean @default(true)

  /// Relations M13 L1
  materiel Materiel[]

  /// Relations M13 L2
  mouvementsStock MouvementStock[]
  bonsOrigine     BonMouvement[]   @relation("BonOrigine")
  bonsDestination BonMouvement[]   @relation("BonDestination")
  inventaires     Inventaire[]
  inspections     Inspection[]

  /// Relations M13 L3
  transportsDépart  DemandeTransport[] @relation("transportDepart")
  transportsArrivée DemandeTransport[] @relation("transportArrivee")

  /// Relations M16 L2
  distributionsCarburant DistributionCarburant[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([nature])
  @@map("lieux_stockage")
}

/**
 * M13 L1 — Type de pièce administrative (référentiel, pas enum)
 * 14 types au seed : assurance, visite technique, VGP, etc.
 * Créable inline par Chef Logistique (permission typePiece:gerer)
 */
model TypePieceAdministrative {
  id               String @id @default(cuid())
  libelle          String @unique
  libelleNormalise String @unique

  /// Périodicité en mois (propose expiration, ne l'impose pas)
  periodiciteMois Int?

  /// Délai d'alerte en jours (ex: 60j pour assurance)
  delaiAlerteJours Int @default(30)

  /// Types de matériel concernés (JSON array de TypeMateriel)
  typesMateriel String @default("[]") // ["VEHICULE_LEGER", "VEHICULE_LOURD"]

  /// Pièce bloquante (empêche sortie si périmée)
  bloquante Boolean @default(false)

  actif          Boolean @default(true)
  ordreAffichage Int     @default(0)

  pieces PieceAdministrative[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@map("types_piece_administrative")
}

/**
 * M13 L1 — Matériel du parc (individuel, code unique)
 * Nature INDIVIDUEL : chaque objet porte son code (AK-PICK001)
 * M8 §1.2 : partageable = affectation simultanée à plusieurs chantiers
 * M13 §3 : 3 codes recherchables (codeIta, numeroParcAncien, codeLong)
 */
model Materiel {
  id String @id @default(cuid())

  /// M13 §3 — Trois codes recherchables (tous uniques)
  codeIta          String  @unique // Code ITA (ex: AK-PICK001)
  numeroParcAncien String? @unique // Ancien N° Parc (ex: A11157)
  codeLong         String? @unique // Format long optionnel

  /// Type et famille
  type      TypeMateriel
  familleId String
  famille   FamilleMateriel @relation(fields: [familleId], references: [id])

  /// Identification
  designation      String
  marque           String?
  modele           String?
  numeroSerie      String? @unique
  immatriculation  String? @unique // Si véhicule
  anneeFabrication Int?

  /// Acquisition (SENSIBLE)
  dateAcquisition DateTime? @db.Date
  coutAcquisition Decimal?  @db.Decimal(12, 0)

  /// Localisation de base (nullable pour reprise)
  lieuBaseId String?
  lieuBase   LieuStockage? @relation(fields: [lieuBaseId], references: [id])

  /// Statut opérationnel
  statut StatutMateriel @default(DISPONIBLE)

  /// M8 §1.2 : Peut être affecté à plusieurs chantiers simultanément
  /// M13 §8 : camion navette oui, pelle mécanique non
  partageable Boolean @default(false)

  /// Observations
  commentaire String?

  /// Relations M8
  affectations           AffectationMateriel[]
  lignesDemandeRessource LigneDemandeRessource[]

  /// Relations M13 L1
  piecesAdministratives PieceAdministrative[]

  /// Relations M13 L2
  relevesCompteur ReleveCompteur[]
  inspections     Inspection[]

  /// Relations M13 L3
  demandesTransport DemandeTransport[] @relation("demandesTransportMateriel")
  plansEntretien    PlanEntretien[]    @relation("plansEntretien")
  entretiens        Entretien[]        @relation("entretiens")

  /// Relations M16 L2
  distributionsCarburant DistributionCarburant[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([type])
  @@index([familleId])
  @@index([lieuBaseId])
  @@index([statut])
  @@map("materiel")
}

/**
 * M13 L1 — Pièce administrative (assurance, visite technique, etc.)
 * CRITIQUE : L'état (VALIDE/ALERTE/PERIME) se CALCULE dynamiquement,
 * jamais stocké. Seule dateExpiration est persistée.
 * Chaîne de renouvellement via remplaceId (historique complet).
 */
model PieceAdministrative {
  id         String   @id @default(cuid())
  materielId String
  materiel   Materiel @relation(fields: [materielId], references: [id], onDelete: Cascade)

  typeId String
  type   TypePieceAdministrative @relation(fields: [typeId], references: [id])

  /// Identifiants de la pièce
  numero   String? // N° de police, PV, patente
  emetteur String? // Compagnie, centre de contrôle

  /// Dates (LE champ qui pilote tout)
  dateEdition    DateTime @db.Date
  dateExpiration DateTime @db.Date

  /// Montant (SENSIBLE)
  montant Decimal? @db.Decimal(12, 0)

  /// Scan PDF (Supabase Storage)
  fichierId String?

  /// Renouvellement — chaîne historique (1:1 avec ancienne pièce)
  remplaceId String?              @unique
  remplace   PieceAdministrative? @relation("Renouvellement", fields: [remplaceId], references: [id])
  renouvele  PieceAdministrative? @relation("Renouvellement")

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([materielId, dateExpiration])
  @@index([typeId])
  @@map("pieces_administratives")
}

// =====================================================================
// M13 L2 — STOCKS ET INVENTAIRES
// =====================================================================

/// M13 L2 — Sens de mouvement stock
enum SensMouvement {
  ENTREE // Achat, production, retour
  SORTIE // Consommation, sortie chantier
  AJUSTEMENT // Correction inventaire
}

/// M13 L2 — Statut d'un inventaire
enum StatutInventaire {
  OUVERT // En cours de comptage
  CLOS // Finalisé, écart ajusté
}

/**
 * M13 L2 — Article de stock (consommable)
 * Nature CONSOMMABLE : quantité qui monte/descend (ciment, filtres, etc.)
 * DISTINCT de Materiel (individuel avec code unique)
 * Le solde se CALCULE depuis les mouvements (jamais stocké)
 */
model ArticleStock {
  id          String @id @default(cuid())
  reference   String @unique // Ex: CIM-50KG, FLT-OIL-5W30
  designation String
  unite       String // L, kg, sac, pièce

  /// Alerte si solde < seuil (notification + tableau de bord)
  seuilAlerte Decimal? @db.Decimal(10, 2)

  /// Famille article (optionnel, pour regroupement)
  famille String?

  actif Boolean @default(true)

  mouvements       MouvementStock[]
  lignesInventaire LigneInventaire[]
  lignesReception  LigneReception[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([famille])
  @@map("articles_stock")
}

/**
 * M13 L2 — Bon de mouvement (entrée, sortie, transfert)
 * Regroupe plusieurs lignes de mouvement
 */
model BonMouvement {
  id        String        @id @default(cuid())
  reference String        @unique // BM-2026-001
  sens      SensMouvement

  /// Lieux concernés
  lieuOrigineId String?
  lieuOrigine   LieuStockage? @relation("BonOrigine", fields: [lieuOrigineId], references: [id])

  lieuDestinationId String?
  lieuDestination   LieuStockage? @relation("BonDestination", fields: [lieuDestinationId], references: [id])

  /// Motif (ex: "Livraison fournisseur", "Consommation chantier Assinie")
  motif String

  /// Émetteur et date
  emetteurId    String   @db.Uuid
  emetteurNom   String
  dateMouvement DateTime @db.Date

  /// Validation (Chef de Service Logistique ou Gestionnaire stocks)
  valideParId String?   @db.Uuid
  valideLe    DateTime?

  mouvements MouvementStock[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([sens])
  @@index([dateMouvement])
  @@map("bons_mouvement")
}

/**
 * M13 L2 — Mouvement de stock (ligne de bon)
 * Le solde se CALCULE depuis ces mouvements (§7.2)
 */
model MouvementStock {
  id String @id @default(cuid())

  articleStockId String
  articleStock   ArticleStock @relation(fields: [articleStockId], references: [id])

  sens     SensMouvement
  quantite Decimal       @db.Decimal(10, 2)

  /// Lieu concerné (origine pour SORTIE, destination pour ENTREE)
  lieuStockageId String
  lieuStockage   LieuStockage @relation(fields: [lieuStockageId], references: [id])

  /// Bon de mouvement (null si ajustement direct)
  bonMouvementId String?
  bonMouvement   BonMouvement? @relation(fields: [bonMouvementId], references: [id])

  /// Motif (obligatoire si ajustement sans bon)
  motif String

  /// Prix unitaire (optionnel, pour valorisation stock)
  prixUnitaire Decimal? @db.Decimal(10, 2)

  dateMouvement DateTime @db.Date

  /// M16 L2 — Relation avec distribution de carburant (si mouvement lié)
  distributionCarburant DistributionCarburant?

  creeLe DateTime @default(now())

  @@index([articleStockId, dateMouvement])
  @@index([lieuStockageId])
  @@index([bonMouvementId])
  @@map("mouvements_stock")
}

/**
 * M13 L2 — Inventaire physique
 * Opération ponctuelle de comptage
 */
model Inventaire {
  id        String @id @default(cuid())
  reference String @unique // INV-2026-01

  /// Lieu inventorié
  lieuStockageId String
  lieuStockage   LieuStockage @relation(fields: [lieuStockageId], references: [id])

  dateOuverture DateTime  @db.Date
  dateClôture  DateTime? @db.Date

  statut StatutInventaire @default(OUVERT)

  /// Responsable inventaire
  responsableId  String @db.Uuid
  responsableNom String

  lignes LigneInventaire[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([lieuStockageId])
  @@index([statut])
  @@map("inventaires")
}

/**
 * M13 L2 — Ligne d'inventaire
 * Comparaison comptage physique vs solde théorique (§8.8)
 */
model LigneInventaire {
  id String @id @default(cuid())

  inventaireId String
  inventaire   Inventaire @relation(fields: [inventaireId], references: [id], onDelete: Cascade)

  articleStockId String
  articleStock   ArticleStock @relation(fields: [articleStockId], references: [id])

  /// Solde théorique (calculé depuis mouvements au moment de l'inventaire)
  soldeTheorique Decimal @db.Decimal(10, 2)

  /// Quantité comptée physiquement
  quantiteComptee Decimal @db.Decimal(10, 2)

  /// Écart = quantiteComptee - soldeTheorique
  ecart Decimal @db.Decimal(10, 2)

  /// Justification de l'écart (obligatoire si écart ≠ 0)
  justification String?

  /// L'écart a-t-il donné lieu à un AJUSTEMENT ?
  ajuste Boolean @default(false)

  creeLe DateTime @default(now())

  @@index([inventaireId])
  @@index([articleStockId])
  @@map("lignes_inventaire")
}

// =====================================================================
// M13 L2 — COMPTEURS ET INSPECTIONS
// =====================================================================

/// M13 L2 — Unité de compteur
enum UniteCompteur {
  KILOMETRE // Véhicules
  HEURE // Engins
}

/// M13 L2 — Source d'un relevé compteur (§1.3)
enum SourceReleve {
  INSPECTION // Inspection entrée/sortie (source principale)
  SAISIE_GARAGE // Saisie manuelle au garage
  RELEVE_ACTIVITE // M6 UtilisationMateriel (quand M6 existera)
  CARBURANT // M16 L2 — Relevé lors d'une distribution de carburant
}

/// M13 L2 — État d'un point d'inspection (§7.4)
enum EtatPoint {
  BON // Conforme
  MAUVAIS // Défectueux (pare-brise fêlé)
  ABSENT // Manquant (rétroviseur disparu) — DISTINCT de MAUVAIS
}

/// M13 L2 — Type de grille d'inspection
enum GrilleInspection {
  PHYSIQUE // Points physiques (30 pour VL, 27 pour engin)
  DOCUMENT // Documents à bord (10 pour VL, 4 pour engin) — présence physique
  EQUIPEMENT // Inventaire de bord (9 points : cric, extincteur, etc.)
}

/// M13 L2 — Moment de l'inspection
enum MomentInspection {
  ENTREE // Inspection à l'arrivée (réception)
  SORTIE // Inspection au départ (remise)
}

/// M13 L2 — Niveau de carburant en huitièmes (§7.4)
enum NiveauCarburant {
  VIDE
  UN_HUITIEME
  UN_QUART
  TROIS_HUITIEMES
  MOITIE
  CINQ_HUITIEMES
  TROIS_QUARTS
  SEPT_HUITIEMES
  PLEIN
}

/**
 * M13 L2 — Relevé de compteur (historique)
 * La valeur courante = dernier relevé (§7.3)
 * L'historique permet de détecter un compteur qui recule (§1.3)
 */
model ReleveCompteur {
  id String @id @default(cuid())

  materielId String
  materiel   Materiel @relation(fields: [materielId], references: [id])

  valeur Decimal       @db.Decimal(10, 2)
  unite  UniteCompteur

  releveLe DateTime     @db.Date
  source   SourceReleve

  /// Si source=INSPECTION, référence l'inspection
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])

  /// Compteur en recul par rapport au dernier relevé (signalé, non refusé)
  anomalie Boolean @default(false)

  releveParId  String @db.Uuid
  releveParNom String

  /// M16 L2 — Relation avec distribution de carburant (si source=CARBURANT)
  distributionCarburant DistributionCarburant?

  creeLe DateTime @default(now())

  @@index([materielId, releveLe])
  @@index([inspectionId])
  @@map("releves_compteur")
}

/**
 * M13 L2 — Point d'inspection (référentiel)
 * Ex: "Pare-brise avant", "Rétroviseurs", "Carte grise", "Cric", etc.
 * Référentiel modifiable sans migration (§7.4)
 */
model PointInspection {
  id      String           @id @default(cuid())
  libelle String           @unique
  grille  GrilleInspection

  /// Types de matériel concernés (JSON array) — "Chenilles" ne vaut pas pour VL
  typesMateriel String @default("[]")

  ordre Int     @default(0) // Ordre d'affichage dans la grille
  actif Boolean @default(true)

  lignes LigneInspection[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([grille, actif])
  @@map("points_inspection")
}

/**
 * M13 L2 — Inspection d'entrée ou de sortie
 * Même grille à l'entrée et à la sortie (§7.4)
 * Obligatoire pour véhicules, engins, conteneurs (§8.5)
 */
model Inspection {
  id String @id @default(cuid())

  materielId String
  materiel   Materiel @relation(fields: [materielId], references: [id])

  moment MomentInspection // ENTREE ou SORTIE

  /// Optionnel : référence au mouvement ou demande transport
  mouvementId        String?
  demandeTransportId String?

  dateHeure DateTime

  lieuId String
  lieu   LieuStockage @relation(fields: [lieuId], references: [id])

  /// Provenance (ENTREE) ou Destination (SORTIE)
  provenance  String?
  destination String?

  /// Compteur (km ou heures) — alimente ReleveCompteur
  compteur Decimal? @db.Decimal(10, 2)

  /// Niveau carburant (huitièmes) — comparaison sortie/retour
  niveauCarburant NiveauCarburant?

  /// Conducteur (→ Employe)
  conducteurId  String? @db.Uuid
  conducteurNom String?

  /// Transporteur (remorqueur externe possible)
  transporteur String?

  /// Vérificateur (Réceptionnaire à l'ENTREE, Remettant à la SORTIE)
  verificateurId  String @db.Uuid
  verificateurNom String

  /// État général
  etatGeneral  EtatPoint
  observations String?

  lignes          LigneInspection[]
  relevesCompteur ReleveCompteur[]

  creeLe DateTime @default(now())

  @@index([materielId, dateHeure])
  @@index([moment])
  @@index([lieuId])
  @@map("inspections")
}

/**
 * M13 L2 — Ligne d'inspection (point contrôlé)
 * Une ligne MAUVAIS ou ABSENT crée une intervention à programmer (§8.6)
 */
model LigneInspection {
  id String @id @default(cuid())

  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  pointId String
  point   PointInspection @relation(fields: [pointId], references: [id])

  etat        EtatPoint
  observation String?

  /// Photo jointe (localise le dommage - §7.5)
  photoId String?

  creeLe DateTime @default(now())

  @@index([inspectionId])
  @@index([pointId])
  @@map("lignes_inspection")
}

// =====================================================================
// M13 L2 — RÉCEPTIONS (ferme le circuit M14)
// =====================================================================

/// M13 L2 — Issue d'une réception
enum IssueReception {
  CONFORME // Validation ouvre droit à facturation (§1.7)
  AVEC_RESERVE // Accepté avec réserves
  NON_CONFORME // Refusé
}

/**
 * M13 L2 — Réception de commande (contrôle conformité)
 * Ferme le circuit M14 (§1.7 et §6.1)
 * Gestionnaire de stocks constate la conformité → ouvre droit à facturation
 */
model Reception {
  id        String @id @default(cuid())
  reference String @unique // REC-2026-001

  /// Commande concernée (M14) — optionnel si réception sans BC
  commandeId String?

  /// Fournisseur
  fournisseurId  String?
  fournisseurNom String

  dateReception DateTime @db.Date

  /// Réceptionnaire (Gestionnaire de stocks)
  receptionneParId  String @db.Uuid
  receptionneParNom String

  /// Validation (Chef de Service Logistique)
  valideParId String?   @db.Uuid
  valideLe    DateTime?

  issue IssueReception?

  /// Motif obligatoire si NON_CONFORME
  motifRefus String?

  /// Photo du défaut si NON_CONFORME
  photoId String?

  lignes LigneReception[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([commandeId])
  @@index([dateReception])
  @@map("receptions")
}

/**
 * M13 L2 — Ligne de réception
 * Comparaison quantité commandée vs livrée
 */
model LigneReception {
  id String @id @default(cuid())

  receptionId String
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  articleStockId String
  articleStock   ArticleStock @relation(fields: [articleStockId], references: [id])

  quantiteCommandee Decimal @db.Decimal(10, 2)
  quantiteLivree    Decimal @db.Decimal(10, 2)

  /// Écart = quantiteLivree - quantiteCommandee
  ecart Decimal @db.Decimal(10, 2)

  conforme    Boolean @default(true)
  observation String?

  creeLe DateTime @default(now())

  @@index([receptionId])
  @@index([articleStockId])
  @@map("lignes_reception")
}

/**
 * Affectation d'un matériel à un projet
 * M8 §5 : Les dates sont obligatoires
 */
model AffectationMateriel {
  id String @id @default(cuid())

  materielId String
  materiel   Materiel @relation(fields: [materielId], references: [id])

  projetId String
  projet   Projet @relation(fields: [projetId], references: [id])

  /// M8 §5 : Dates obligatoires pour le planning du parc
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date

  /// Observations
  commentaire String?

  /// Traçabilité
  affecteParId String   @db.Uuid
  affecteLe    DateTime @default(now())

  @@index([materielId])
  @@index([projetId])
  @@index([dateDebut])
  @@index([dateFin])
  @@map("affectations_materiel")
}

/**
 * Demande de ressource (humaine ou matérielle)
 * M8 §4 : Deux natures avec circuits différents
 * M8 §5 : Circuit B-01 (N+1 puis service compétent)
 */
model DemandeRessource {
  id String @id @default(cuid())

  /// Nature de la demande
  nature NatureDemandeRessource

  /// Projet demandeur
  projetId String
  projet   Projet @relation(fields: [projetId], references: [id])

  /// Demandeur
  demandeurId  String @db.Uuid
  demandeurNom String

  /// Période demandée
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date

  /// Justification
  motif String

  /// Statut
  statut StatutDemandeRessource @default(BROUILLON)

  /// Validation N+1
  valideN1ParId String?   @db.Uuid
  valideN1Le    DateTime?
  motifRefusN1  String?

  /// Validation service compétent
  valideServiceParId String?   @db.Uuid
  valideServiceLe    DateTime?
  motifRefusService  String?

  /// Lignes de demande
  lignes LigneDemandeRessource[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([projetId])
  @@index([nature])
  @@index([statut])
  @@map("demandes_ressource")
}

/**
 * Ligne de demande (individuelle)
 * Soit une compétence (maçon, électricien) avec quantité,
 * soit un matériel spécifique
 */
model LigneDemandeRessource {
  id String @id @default(cuid())

  demandeId String
  demande   DemandeRessource @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  /// Pour demande HUMAINE : description compétence
  competence String?
  quantite   Int?

  /// Pour demande MATERIELLE : matériel spécifique
  materielId String?
  materiel   Materiel? @relation(fields: [materielId], references: [id])

  /// Observations
  commentaire String?

  creeLe DateTime @default(now())

  @@index([demandeId])
  @@index([materielId])
  @@map("lignes_demande_ressource")
}

// =====================================================================
// M14 — ACHATS
// =====================================================================

/// Unité de mesure pour articles
model Unite {
  id       String    @id @default(cuid())
  libelle  String    @unique
  creeLe   DateTime  @default(now())
  creePar  String
  articles Article[]

  @@map("unites")
}

/// Article du bordereau de prix
model Article {
  id                    String            @id @default(cuid())
  designation           String // "Ciment CPA 45 — sac 50 kg"
  designationNormalisee String            @unique // Normalisation sans accent ni casse
  uniteId               String
  unite                 Unite             @relation(fields: [uniteId], references: [id])
  actif                 Boolean           @default(true)
  creeLe                DateTime          @default(now())
  creePar               String
  prix                  PrixFournisseur[]
  lignes                LigneAchat[]

  @@index([designation])
  @@map("articles")
}

/// Fournisseur
model Fournisseur {
  id           String            @id @default(cuid())
  nom          String
  nomNormalise String            @unique // Normalisation sans accent ni casse
  numeroWave   String? // Identifiant Wave Money pour paiement mobile (donnée sensible)
  actif        Boolean           @default(true)
  creeLe       DateTime          @default(now())
  creePar      String
  prix         PrixFournisseur[]
  lignes       LigneAchat[]

  @@index([nom])
  @@map("fournisseurs")
}

/// Prix d'un article chez un fournisseur
model PrixFournisseur {
  id            String      @id @default(cuid())
  articleId     String
  article       Article     @relation(fields: [articleId], references: [id])
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])
  prixHT        Decimal     @db.Decimal(12, 2)
  actif         Boolean     @default(true)
  creeLe        DateTime    @default(now())
  creePar       String

  @@unique([articleId, fournisseurId])
  @@index([articleId])
  @@index([fournisseurId])
  @@map("prix_fournisseur")
}

enum TypeDemande {
  INITIALE
  REGULARISATION
}

enum StatutDemandeAchat {
  BROUILLON
  ATTENTE_N1
  ATTENTE_ACHATS
  ATTENTE_COMITE
  BC_EMIS
  PARTIELLE
  SOLDEE
  REFUSEE
}

enum StatutReception {
  CONFORME
  RESERVE
  REFUS
}

enum TypeEvenementAchat {
  SOUMISSION
  VALIDATION_N1
  REFUS_N1
  INSTRUCTION
  TRANSMISSION_COMITE
  AVIS_COMITE
  EMISSION_BC
  TRANSMISSION_LOG
  RECEPTION
  VALIDATION_CONFORMITE
  FACTURATION
  REFUS
}

enum EtatAvis {
  ATTENTE
  FAVORABLE
  DEFAVORABLE
}

/// Demande d'achat
model DemandeAchat {
  id             String      @id @default(cuid())
  ref            String      @unique // DA-2026-047
  type           TypeDemande
  demandeurId    String
  demandeur      Employe     @relation("DemandesDemandeur", fields: [demandeurId], references: [id])
  beneficiaireId String
  beneficiaire   Employe     @relation("DemandesBeneficiaire", fields: [beneficiaireId], references: [id])
  destinationId  String // Projet ou Service
  description    String
  dateBesoin     DateTime    @db.Date
  urgent         Boolean     @default(false)
  creeLe         DateTime    @default(now())

  /// Références renseignées lors du circuit
  refBC      String? /// Renseigné à l'émission du bon de commande
  refFacture String? /// Renseigné par la DFC à la facturation

  lignes     LigneAchat[]
  evenements EvenementAchat[]
  avisComite AvisComite[]

  @@index([ref])
  @@index([demandeurId])
  @@index([beneficiaireId])
  @@map("demandes_achat")
}

/// Ligne d'article commandé
model LigneAchat {
  id              String           @id @default(cuid())
  demandeId       String
  demande         DemandeAchat     @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  articleId       String?
  article         Article?         @relation(fields: [articleId], references: [id])
  designation     String // Figé à la commande
  quantite        Decimal          @db.Decimal(10, 3)
  unite           String // Figé
  fournisseurId   String?
  fournisseur     Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  prixUnitaire    Decimal?         @db.Decimal(12, 2) // Figé à l'instruction
  tauxTva         Decimal?         @db.Decimal(5, 2) // Figé à l'instruction (ex: 18.00)
  quantiteRecue   Decimal?         @db.Decimal(10, 3)
  statutReception StatutReception?
  numBC           String?
  facture         String?
  criteres        String? // Motif de sélection du fournisseur

  @@index([demandeId])
  @@map("lignes_achat")
}

/// Événement dans le circuit de validation
model EvenementAchat {
  id        String             @id @default(cuid())
  demandeId String
  demande   DemandeAchat       @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  type      TypeEvenementAchat
  auteurId  String
  auteurNom String
  timestamp DateTime           @default(now())
  details   Json?

  @@index([demandeId, timestamp])
  @@map("evenements_achat")
}

/// Avis d'un membre du comité
model AvisComite {
  id         String       @id @default(cuid())
  demandeId  String
  demande    DemandeAchat @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  role       String // DG, DRH, DFC, DT
  validateur String // Nom complet
  etat       EtatAvis     @default(ATTENTE)
  timestamp  DateTime?
  motif      String?

  @@unique([demandeId, role])
  @@index([demandeId])
  @@map("avis_comite")
}

// ═══════════════════════════════════════════════════════════════════════
// M15 — ITAPAY : Exécution des paiements via Wave
// ═══════════════════════════════════════════════════════════════════════

/// Demande de paiement - peut provenir de la paie, d'achats, etc.
model DemandePaiement {
  id           String            @id @default(cuid())
  referenceIta String            @unique /// Format: PAI-2026-001
  categorie    CategoriePaiement

  /// Source de la demande (ex: période de paie, bon de commande)
  sourceId   String
  sourceType String /// PAIE, ACHAT, FOURNISSEUR, DIVERS

  /// Préparation
  prepareeParId String   @db.Uuid
  preparateur   Profil   @relation("PreparateurPaiement", fields: [prepareeParId], references: [id])
  prepareeLe    DateTime @default(now())

  montantTotal Decimal @db.Decimal(12, 2)

  /// Relations
  lignes       LignePaiement[]
  autorisation AutorisationPaiement?
  releve       RelevePaiement?

  @@index([prepareeParId])
  @@index([categorie])
  @@map("demandes_paiement")
}

/// Ligne de paiement individuelle - un bénéficiaire, un montant
model LignePaiement {
  id                String          @id @default(uuid())
  demandePaiementId String
  demandePaiement   DemandePaiement @relation(fields: [demandePaiementId], references: [id], onDelete: Cascade)

  /// Clé d'idempotence — générée À LA CRÉATION, jamais à l'appel
  cleIdempotence String @unique @default(uuid())

  /// Copies figées — le bénéficiaire peut changer de numéro ensuite
  beneficiaireNom    String
  beneficiaireMobile String /// E.164 format: +2250701234567
  montant            Decimal @db.Decimal(12, 2)
  motifPaiement      String /// 40 caractères max, visible du destinataire
  referenceIta       String /// → client_reference Wave

  /// Vérification préalable (verify_recipient)
  verifieLe    DateTime?
  nameMatch    NameMatch?
  withinLimits Boolean?

  /// Résultat
  statut        StatutPaiement @default(PREPARE)
  wavePayoutId  String?
  waveErrorCode String?
  fraisWave     Decimal?       @db.Decimal(12, 2)
  executeLe     DateTime?

  /// Relations
  tentatives TentativePaiement[]

  @@index([demandePaiementId])
  @@index([statut])
  @@map("lignes_paiement")
}

/// Autorisation de paiement par le DG
model AutorisationPaiement {
  demandePaiementId String          @unique
  demandePaiement   DemandePaiement @relation(fields: [demandePaiementId], references: [id], onDelete: Cascade)

  /// Demande
  demandeeParId String   @db.Uuid
  demandeur     Profil   @relation("DemandeurAutorisation", fields: [demandeeParId], references: [id])
  demandeeLe    DateTime @default(now())

  /// Autorisation
  autoriseeParId String?   @db.Uuid
  autorisateur   Profil?   @relation("AutorisateurPaiement", fields: [autoriseeParId], references: [id])
  autoriseeLe    DateTime?
  expireLe       DateTime? /// = autoriseeLe + durée, plafonné à 14 h

  /// Montant figé — si le montant change, l'autorisation tombe
  montantFige  Decimal @db.Decimal(12, 2)
  nombreEchecs Int     @default(0)

  /// Refus
  refuseeLe  DateTime?
  motifRefus String?   @db.Text

  @@index([demandeeParId])
  @@index([autoriseeParId])
  @@map("autorisations_paiement")
}

/// Tentative d'appel à Wave - conserve la réponse brute
model TentativePaiement {
  id              String        @id @default(cuid())
  lignePaiementId String
  lignePaiement   LignePaiement @relation(fields: [lignePaiementId], references: [id], onDelete: Cascade)

  numero       Int /// 1, 2, 3...
  envoyeeLe    DateTime @default(now())
  httpStatus   Int?
  reponseBrute Json /// Réponse Wave complète, telle que reçue
  erreurCode   String?

  @@unique([lignePaiementId, numero])
  @@index([lignePaiementId])
  @@map("tentatives_paiement")
}

/// Relevé de paiement - pièce comptable
model RelevePaiement {
  id                String          @id @default(cuid())
  demandePaiementId String          @unique
  demandePaiement   DemandePaiement @relation(fields: [demandePaiementId], references: [id], onDelete: Cascade)

  numeroReleve String   @unique /// REL-2026-001
  genereeLe    DateTime @default(now())
  montantTotal Decimal  @db.Decimal(12, 2)
  fraisTotaux  Decimal  @db.Decimal(12, 2)
  nombreLignes Int

  /// Pièce comptable
  pdfUrl String?

  @@index([numeroReleve])
  @@map("releves_paiement")
}

/// Solde du portefeuille Wave - historique quotidien
model SoldeWave {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  solde       Decimal  @db.Decimal(12, 2)
  devise      String   @default("XOF")
  interrogeLe DateTime @default(now())

  @@unique([date])
  @@index([date])
  @@map("soldes_wave")
}

// ═══════════════════════════════════════════════════════════════════════
// ENUMS M15
// ═══════════════════════════════════════════════════════════════════════

enum StatutPaiement {
  PREPARE /// Ligne créée, pas encore vérifiée
  VERIFIE /// verify_recipient appelé
  AUTORISE /// Autorisation accordée
  EN_COURS /// Paiement en cours chez Wave (processing)
  EN_ATTENTE /// État inconnu — NE JAMAIS rejouer sans la même clé
  REUSSI /// Paiement réussi (succeeded)
  ECHOUE /// Échec définitif
  ANNULE /// Annulé (reversed)
}

enum CategoriePaiement {
  SALAIRES /// Paie mensuelle
  PRIMES /// Primes et avantages
  FOURNISSEURS /// Paiement fournisseur
  PRESTATAIRES /// Prestataires externes
  DIVERS /// Autres paiements
}

enum NameMatch {
  MATCH /// Le nom correspond
  NO_MATCH /// Le nom ne correspond pas — BLOQUE la ligne
  NAME_NOT_KNOWN /// Wave ne connaît pas le nom
}

// ═══════════════════════════════════════════════════════════════════════
// M13 L3 — TRANSPORT ET ENTRETIEN
// ═══════════════════════════════════════════════════════════════════════

/// Type de demande de transport
enum TypeDemandeTransport {
  MATERIEL
  PERSONNEL
  MIXTE
}

/// Statut de demande de transport
enum StatutDemandeTransport {
  EN_ATTENTE
  APPROUVEE
  AFFECTEE
  EN_COURS
  TERMINEE
  ANNULEE
}

/// Type d'entretien
enum TypeEntretien {
  PREVENTIF
  CURATIF
  REVISION
}

/**
 * M13 L3 — Demande de transport
 * Gestion des demandes de transport de matériel et/ou personnel
 */
model DemandeTransport {
  id        String                 @id @default(cuid())
  reference String                 @unique /// Format: DTR-xxxxx
  type      TypeDemandeTransport
  statut    StatutDemandeTransport @default(EN_ATTENTE)

  /// Demandeur
  demandeurId String @db.Uuid
  demandeur   Profil @relation("demandesTransport", fields: [demandeurId], references: [id])

  /// Matériel à transporter (optionnel)
  materielId String?
  materiel   Materiel? @relation("demandesTransportMateriel", fields: [materielId], references: [id])

  /// Lieux de départ et d'arrivée
  lieuDepartId String
  lieuDepart   LieuStockage @relation("transportDepart", fields: [lieuDepartId], references: [id])

  lieuArriveeId String
  lieuArrivee   LieuStockage @relation("transportArrivee", fields: [lieuArriveeId], references: [id])

  /// Dates
  dateDebut DateTime  @db.Date
  dateFin   DateTime? @db.Date

  /// Chauffeur affecté (optionnel)
  chauffeurId String?
  chauffeur   Employe? @relation("chauffeur", fields: [chauffeurId], references: [id])

  /// Description
  description String? @db.Text

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([demandeurId])
  @@index([materielId])
  @@index([statut])
  @@index([dateDebut])
  @@map("demandes_transport")
}

/**
 * M13 L3 — Plan d'entretien
 * Planification préventive des entretiens par matériel
 */
model PlanEntretien {
  id         String   @id @default(cuid())
  materielId String
  materiel   Materiel @relation("plansEntretien", fields: [materielId], references: [id])

  type             TypeEntretien
  description      String
  periodiciteJours Int? /// Périodicité en jours
  seuilCompteur    Int? /// Seuil en km/heures

  actif Boolean @default(true)

  /// Relations
  entretiens Entretien[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([materielId])
  @@map("plans_entretien")
}

/**
 * M13 L3 — Entretien (réalisé)
 * Historique des entretiens effectués sur le matériel
 */
model Entretien {
  id String @id @default(cuid())

  /// Plan d'entretien (null si entretien non planifié)
  planId String?
  plan   PlanEntretien? @relation(fields: [planId], references: [id])

  /// Matériel concerné
  materielId String
  materiel   Materiel @relation("entretiens", fields: [materielId], references: [id])

  type      TypeEntretien
  dateDebut DateTime      @db.Date
  dateFin   DateTime?     @db.Date

  /// Compteur au moment de l'entretien
  compteur Int?

  /// Coût de l'entretien (SENSIBLE)
  cout Decimal? @db.Decimal(15, 2)

  technicien   String?
  description  String  @db.Text
  observations String? @db.Text

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([materielId])
  @@index([planId])
  @@index([type])
  @@index([dateDebut])
  @@map("entretiens")
}

// ═══════════════════════════════════════════════════════════════════════
// M16 — ASSISTANAT DE DIRECTION
// ═══════════════════════════════════════════════════════════════════════

/**
 * M16 — Registre des visiteurs
 * Conservation : 3 mois maximum (purge automatique)
 * Données personnelles de TIERS (ni employés ni clients)
 * Aucune image de pièce d'identité stockée
 */
model Visite {
  id String @id @default(cuid())

  /// Identité du visiteur (texte libre)
  nomVisiteur String
  societe     String?
  telephone   String?

  /// Personne visitée — lien vers M2
  visiteId String
  visite   Employe @relation("VisitesRecues", fields: [visiteId], references: [id])

  motif        MotifVisite
  pieceDeposee Boolean     @default(false)

  /// Horodatage automatique à l'arrivée
  arriveeLe DateTime  @default(now())
  /// null tant que la personne est présente
  sortieLe  DateTime?

  /// Qui a saisi cette visite
  saisieParId String @db.Uuid
  saisiePar   Profil @relation(fields: [saisieParId], references: [id])

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([arriveeLe])
  @@index([sortieLe])
  @@index([visiteId])
  @@map("visites")
}

/**
 * M16 — Registre du courrier (arrivée et départ)
 * Un seul modèle, deux vues filtrées par `sens`
 * Numéro généré : ITA-{ANNEE}-{SEQ:4}, séquence commune aux deux sens
 */
model Courrier {
  id String @id @default(cuid())

  /// Généré au format ITA-2026-0142, séquence annuelle commune
  numero String @unique

  sens SensCourrier

  /// Date portée sur le courrier
  dateCorrespondance DateTime @db.Date
  /// Date de passage par l'Assistanat
  datePassage        DateTime @db.Date

  /// Expéditeur à l'arrivée, destinataire au départ
  tiers          String
  /// Référence portée par le tiers sur son courrier
  referenceTiers String?

  objet String @db.Text

  /// Destinataire à l'arrivée, expéditeur au départ — lien vers M1
  serviceId   String?
  service     Service?   @relation(fields: [serviceId], references: [id])
  directionId String?
  direction   Direction? @relation(fields: [directionId], references: [id])

  /// Scan du courrier (Supabase Storage, URL signée)
  fichierId String?

  /// Suivi de traitement — ARRIVEE seulement
  statutTraitement      StatutTraitement @default(A_TRAITER)
  traiteLe              DateTime?
  traiteParId           String?          @db.Uuid
  traitePar             Profil?          @relation("CourriersTraites", fields: [traiteParId], references: [id])
  commentaireTraitement String?          @db.Text

  /// Qui a saisi ce courrier
  saisieParId String @db.Uuid
  saisiePar   Profil @relation("CourriersSaisis", fields: [saisieParId], references: [id])

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([sens, datePassage])
  @@index([referenceTiers])
  @@index([statutTraitement])
  @@index([serviceId])
  @@index([directionId])
  @@map("courriers")
}

/**
 * M16 L2 — Distribution de carburant
 * Deux natures: STATION (dépense) ou CUVE (mouvement de stock)
 * Crée automatiquement un ReleveCompteur
 */
model DistributionCarburant {
  id        String @id @default(cuid())
  reference String @unique /// DC-2026-0001

  /// Qui demande — lien vers M2
  demandeurId String
  demandeur   Employe @relation("DistributionsCarburantDemandees", fields: [demandeurId], references: [id])

  /// Pour quel matériel — lien vers M13
  materielId String
  materiel   Materiel @relation(fields: [materielId], references: [id])

  typeCarburant TypeCarburant
  quantite      Decimal       @db.Decimal(10, 2) /// Litres
  montant       Decimal?      @db.Decimal(12, 0) /// FCFA — optionnel en cuve, requis en station

  /// Compteur au moment de la demande
  compteur         Decimal       @db.Decimal(10, 2)
  uniteCompteur    UniteCompteur
  pleinComplet     Boolean       @default(true) /// Borne l'intervalle de calcul
  compteurAnomalie Boolean       @default(false) /// Recul détecté
  motifAnomalie    String?

  /// Nature — deux circuits distincts
  nature NatureDistribution

  /// Si STATION
  stationId String?
  station   StationService? @relation(fields: [stationId], references: [id])

  /// Si CUVE
  lieuStockageId String?
  lieuStockage   LieuStockage? @relation(fields: [lieuStockageId], references: [id])

  /// Le mouvement de stock créé (si CUVE)
  mouvementStockId String?          @unique
  mouvementStock   MouvementStock? @relation(fields: [mouvementStockId], references: [id])

  /// Qui a servi
  serviParId       String   @db.Uuid
  dateDistribution DateTime @db.Date

  /// Le relevé de compteur créé dans M13
  releveCompteurId String?          @unique
  releveCompteur   ReleveCompteur? @relation(fields: [releveCompteurId], references: [id])

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([materielId, dateDistribution])
  @@index([demandeurId])
  @@index([stationId])
  @@index([lieuStockageId])
  @@map("distributions_carburant")
}

/**
 * M16 L2 — Station-service (référentiel)
 * Création inline avec R-04
 */
model StationService {
  id                   String @id @default(cuid())
  libelle              String @unique
  libelleNormalise     String @unique /// Pour détecter les doublons à la création inline
  localisation         String?
  actif                Boolean                   @default(true)
  distributions        DistributionCarburant[]
  creeLe               DateTime                  @default(now())
  modifieLe            DateTime                  @updatedAt
  @@map("stations_service")
}

// ═══════════════════════════════════════════════════════════════════════
// M19 — MISSIONS ET FRAIS DE MISSION
// ═══════════════════════════════════════════════════════════════════════

/**
 * Mission — Livraison 1
 *
 * SEPT DÉCISIONS STRUCTURANTES (DECISIONS-M19.md § 2)
 *
 * 2.1  Les frais sont AVANCÉS, pas remboursés.
 * 2.2  Saisie libre, justificatifs obligatoires. Contrôle ligne à ligne.
 * 2.3  Le supérieur direct vise d'abord — aucune exception.
 * 2.4  Le rapport justifie les frais. Pas de rapport, pas de régularisation.
 * 2.5  Deux moyens de paiement — Wave par M15, ou espèces sous plafond.
 * 2.6  Le statut se déduit, il ne se stocke pas. Onze états.
 * 2.7  Une mission ne se supprime pas. Elle s'annule, et plus du tout
 *      une fois l'avance versée.
 *
 * AUCUN CHAMP `statut`. lib/utils/missions.ts porte la fonction de
 * déduction. L'ordre des tests compte — voir M19-MISSIONS.md § 3.1.
 */
model Mission {
  id             String   @id @default(uuid())

  /// Format MIS-AAAA-NNNN. Généré par le serveur.
  reference      String   @unique

  demandeurId    String
  demandeur      Employe  @relation(fields: [demandeurId], references: [id])

  objet          String
  destination    String

  /// Pays hors Côte d'Ivoire. Null si mission nationale. TODO: Ajouter foreign key quand Pays sera créé.
  paysId         String?

  moyenTransport MoyenTransport

  dateDepart     DateTime @db.Date
  dateRetour     DateTime @db.Date

  /// Montant total des lignes d'estimation. Livraison 2.
  fraisEstimes   Decimal  @db.Decimal(12, 0) @default(0)

  /// Rattachement optionnel à un projet.
  projetId       String?
  projet         Projet?  @relation(fields: [projetId], references: [id])

  // ────────────────────────────────────────────────────────────────────
  // ÉVÉNEMENTS DU CIRCUIT — dans l'ordre chronologique
  // ────────────────────────────────────────────────────────────────────

  soumiseLe      DateTime?

  viseeN1Le      DateTime?
  viseeN1ParId   String?   @db.Uuid
  viseeN1Par     Profil?   @relation("VisaMission", fields: [viseeN1ParId], references: [id])

  valideeRhLe    DateTime?
  valideeRhParId String?   @db.Uuid
  valideeRhPar   Profil?   @relation("ValidationRhMission", fields: [valideeRhParId], references: [id])

  /// Livraison 2 — L'avance a été versée par la DFC.
  avanceVerseeLe DateTime?

  rapportDeposeLe DateTime?

  /// Livraison 2 — La régularisation est terminée.
  clotureeLe     DateTime?
  clotureeParId  String?   @db.Uuid
  clotureePar    Profil?   @relation("ClotureMission", fields: [clotureeParId], references: [id])

  /// Refus — à quelle étape (visa ou validation).
  refuseeLe      DateTime?
  refuseeParId   String?   @db.Uuid
  refuseePar     Profil?   @relation("RefusMission", fields: [refuseeParId], references: [id])
  motifRefus     String?
  etapeRefus     EtapeRefus?

  /// Annulation — seulement AVANT le versement de l'avance.
  annuleeLe      DateTime?
  annuleeParId   String?   @db.Uuid
  annuleePar     Profil?   @relation("AnnulationMission", fields: [annuleeParId], references: [id])
  motifAnnulation String?

  // ────────────────────────────────────────────────────────────────────
  // RELATIONS
  // ────────────────────────────────────────────────────────────────────

  /// Livraison 2
  lignesFrais    LigneFrais[]

  rapport        RapportMission?

  /// Livraison 2
  versements     VersementAvance[]

  /// Livraison 2
  regularisation Regularisation?

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt

  @@index([demandeurId, dateDepart])
  @@index([dateRetour])
  @@map("missions")
}

/**
 * LigneFrais — Livraison 2
 *
 * Deux usages :
 *   — estimation (avant le départ)
 *   — dépense réelle (après le retour)
 *
 * Le contrôle porte sur les dépenses réelles, ligne à ligne.
 * Les estimations n'engagent à rien.
 */
model LigneFrais {
  id          String   @id @default(uuid())

  missionId   String
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// ESTIMATION ou REEL
  moment      MomentFrais

  categorie   CategorieFrais
  libelle     String
  montant     Decimal  @db.Decimal(12, 0)

  /// Contrôle DFC — lignes réelles uniquement.
  /// Null si non encore contrôlée.
  accepteeLe  DateTime?
  accepteeParId String? @db.Uuid
  accepteePar Profil?  @relation("ControlefraisMission", fields: [accepteeParId], references: [id])

  /// Si rejetée, motif obligatoire.
  rejeteeLe   DateTime?
  rejeteeParId String? @db.Uuid
  rejeteePar  Profil?  @relation("RejetFraisMission", fields: [rejeteeParId], references: [id])
  motifRejet  String?

  /// URL du justificatif — Cloudflare R2. Obligatoire pour dépenses réelles.
  justificatif String?

  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  @@index([missionId, moment])
  @@map("lignes_frais")
}

/**
 * RapportMission — Livraison 1
 *
 * RÈGLE BLOQUANTE : pas de rapport, pas de nouvelle mission.
 */
model RapportMission {
  id           String   @id @default(uuid())

  missionId    String   @unique
  mission      Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// Objet réalisé — 30 caractères minimum.
  objetRealise String

  /// Résultats et conclusions — 30 caractères minimum.
  resultats    String

  /// Difficultés rencontrées — optionnel.
  difficultes  String?

  /// Recommandations — optionnel.
  recommandations String?

  deposeLe     DateTime @default(now())

  @@map("rapports_mission")
}

/**
 * VersementAvance — Livraison 2
 *
 * DEUX MOYENS (DECISIONS-M19.md § 2.5)
 *
 *   — WAVE : passe par M15, circuit à quatre yeux.
 *   — ESPECES : plafonné (150 000 F proposé), émargement obligatoire.
 *
 * Une mission peut avoir plusieurs versements (acompte + complément).
 */
model VersementAvance {
  id              String   @id @default(uuid())

  missionId       String
  mission         Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  montant         Decimal  @db.Decimal(12, 0)
  moyen           MoyenPaiementMission

  /// Si WAVE : lien vers la demande M15.
  demandePaiementId String?

  /// Si ESPECES : émargement obligatoire — PDF ou image.
  emargement      String?

  /// L'avance a été effectivement remise.
  effectueLe      DateTime?
  effectueParId   String?  @db.Uuid
  effectuePar     Profil?  @relation("VersementAvanceMission", fields: [effectueParId], references: [id])

  creeLe          DateTime @default(now())

  @@index([missionId])
  @@map("versements_avance")
}

/**
 * Regularisation — Livraison 2
 *
 * TROIS CAS (DECISIONS-M19.md § 2.4)
 *
 *   — COMPLEMENT : dépenses > avance → versement à l'employé.
 *   — RELIQUAT : dépenses < avance → l'employé doit de l'argent.
 *   — EQUILIBRE : dépenses = avance → aucun mouvement.
 *
 * Le reliquat peut s'apurer par trois moyens : espèces, Wave, retenue sur
 * salaire (si licite).
 *
 * RÈGLE : les totaux sont FIGÉS au moment du contrôle. Une modification
 * ultérieure d'une ligne ne les change pas.
 */
model Regularisation {
  id                String   @id @default(uuid())

  missionId         String   @unique
  mission           Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// Montant total des versements d'avance.
  totalAvance       Decimal  @db.Decimal(12, 0)

  /// Montant total des dépenses acceptées.
  totalJustifie     Decimal  @db.Decimal(12, 0)

  sens              SensRegularisation

  /// Montant à verser (si COMPLEMENT) ou à rendre (si RELIQUAT).
  montant           Decimal  @db.Decimal(12, 0)

  /// COMPLEMENT ou RELIQUAT apuré.
  apureeLe          DateTime?
  apureeParId       String?  @db.Uuid
  apureePar         Profil?  @relation("ApurementMission", fields: [apureeParId], references: [id])
  moyenApurement    MoyenApurement?

  /// Si WAVE : lien vers la demande M15.
  demandePaiementId String?

  /// Si ESPECES : émargement.
  emargement        String?

  creeLe            DateTime @default(now())

  @@map("regularisations")
}

