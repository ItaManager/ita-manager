// =====================================================================
// ITA SARL — Schéma de données — M0 (Socle)
//
// Ce fichier ne porte que les 9 modèles nécessaires à M0 (cf. décision
// confirmée avec l'utilisateur, M0-SOCLE.md §4), pas le schéma cible
// complet du produit — celui-ci reste consultable tel quel dans
// docs/schema-cible.prisma, module par module.
//
// Conventions reprises du schéma cible :
//   · Horodatages : DateTime @default(now()) en UTC
//   · Suppression : archiveLe DateTime? — jamais de DELETE physique
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connexion mutualisée (pgBouncer, port 6543) — utilisée par l'application
  url       = env("DATABASE_URL")
  // Connexion directe (port 5432) — requise par les migrations et introspect
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// PROFILS ET HABILITATIONS
//
// L'authentification est assurée par Supabase Auth : la table
// `auth.users` détient l'identité, le mot de passe et les sessions.
// Prisma ne la gère pas — elle vit dans un schéma que les migrations
// ne doivent pas toucher.
//
// `Profil.id` reprend l'UUID de `auth.users.id`. Le lien est maintenu
// par un trigger Postgres (migration écrite à la main) à la création
// du compte Supabase.
// =====================================================================


/// Rôle applicatif. Distinct du poste : un Chef Chantier peut porter
/// le rôle de saisie des relevés sans que le poste ne l'implique.
model Role {
  id          String  @id @default(cuid())
  code        String  @unique // ADMIN, DRH, RH, DT, CT, CC, CE, DFC, DG
  libelle     String
  description String?
  systeme     Boolean @default(false) // non supprimable

  permissions RolePermission[]
  profils     ProfilRole[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id      String @id @default(cuid())
  code    String @unique // employe:creer, derogation:valider, paie:validerDT…
  libelle String
  domaine String // RH, PAIE, TECHNIQUE, REFERENTIEL, ADMIN

  roles RolePermission[]

  @@index([domaine])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ProfilRole {
  profilId   String   @db.Uuid
  roleId     String
  profil     Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  attribueLe DateTime @default(now())

  @@id([profilId, roleId])
  @@map("profil_roles")
}

/// Codes de secours MFA (TOTP) — dix codes à usage unique, générés à
/// l'activation, affichés une seule fois, jamais stockés en clair.
/// Absent du schéma cible fourni, ajouté en M0 (décision confirmée
/// avec l'utilisateur) car requis par le critère de recette de la
/// double authentification.
model CodeSecoursMfa {
  id        String    @id @default(cuid())
  profilId  String    @db.Uuid
  profil    Profil    @relation(fields: [profilId], references: [id], onDelete: Cascade)
  codeHache String
  utiliseLe DateTime?
  creeLe    DateTime  @default(now())

  @@index([profilId])
  @@map("codes_secours_mfa")
}

/// Créé en M0, utilisé à partir de M2 (décision E-03).
model Brouillon {
  id String @id @default(cuid())

  profilId String @db.Uuid

  /// Type d'entité concernée : Employe, ReleveActivite, AppelOffres…
  entite String
  /// Identifiant de l'entité en cours de modification. `null` en création.
  entiteId String?

  donnees Json

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@unique([profilId, entite, entiteId])
  @@index([modifieLe])
  @@map("brouillons")
}

/// Paramètres applicatifs typés par clé. Évite une table par famille.
model Parametre {
  id      String @id @default(cuid())
  cle     String @unique
  valeur  String // sérialisé, typé côté applicatif via zod
  type    String // NUMBER, STRING, BOOLEAN, JSON
  groupe  String // AO, PROJET, RELEVE, RH, PAIE
  libelle String
  aide    String?

  modifieParId String?
  modifieLe    DateTime @updatedAt

  @@index([groupe])
  @@map("parametres")
}

/// Journal d'audit transverse. Toute décision opposable y est tracée :
/// validations, refus, changements de règle, révisions de grille.
model JournalEvenement {
  id String @id @default(cuid())

  entite   String // Profil, Role, ProfilRole…
  entiteId String
  action   String // CREATION, MODIFICATION, VALIDATION, REFUS, ARCHIVAGE

  auteurId  String? @db.Uuid
  auteur    Profil? @relation(fields: [auteurId], references: [id])
  auteurNom String

  /// Différentiel avant/après, ou contexte de la décision
  details     Json?
  commentaire String?

  survenuLe DateTime @default(now())

  @@index([entite, entiteId])
  @@index([survenuLe])
  @@map("journal_evenements")
}

/// Créée en M0 pour que les modules suivants puissent y écrire
/// (décision E-05). Non exploitée par un écran de M0.
model Notification {
  id String @id @default(cuid())

  destinataireId String  @db.Uuid
  type           String // ECHEANCE_CONTRAT, JALON_RETARD, PAIE_A_CLOTURER…
  titre          String
  message        String
  lienEntite     String?
  lienEntiteId   String?

  lue   Boolean   @default(false)
  lueLe DateTime?

  /// Envoi par courriel via Resend
  emailEnvoye   Boolean   @default(false)
  emailEnvoyeLe DateTime?
  emailResendId String?

  creeLe DateTime @default(now())

  @@index([destinataireId, lue])
  @@index([emailEnvoye])
  @@map("notifications")
}

// =====================================================================
// ORGANISATION — M1
//
// Trois niveaux : Direction › Service › Poste
// Ces trois niveaux sont des TABLES et non des enums. L'organigramme
// évolue (DECISIONS.md A-01 à A-11).
// =====================================================================

enum NiveauHierarchique {
  DIRECTION
  CADRE
  SUPPORT
  OPERATIONNEL
}

// =====================================================================
// EMPLOYÉS — M2
//
// Type de main-d'œuvre : PERMANENT (dossier complet) vs JOURNALIER
// (4 champs seulement). Décision A-11, A-12.
// =====================================================================

enum TypeMainOeuvre {
  PERMANENT
  JOURNALIER
}

enum TypeContrat {
  CDI
  CDD
  INTERIM
  STAGE
}

enum SituationMatrimoniale {
  CELIBATAIRE
  MARIE
  DIVORCE
  VEUF
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum ModePaiement {
  VIREMENT
  WAVE
}

enum StatutDerogation {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

// =====================================================================
// M4 — RÉMUNÉRATION
// =====================================================================

enum StatutGrille {
  BROUILLON
  PUBLIEE
  ARCHIVEE
}

// =====================================================================
// M5 — PROJETS ET PLANNING
// =====================================================================

enum StatutProjet {
  BROUILLON
  OUVERT
  EN_COURS
  SUSPENDU
  CLOTURE
}

enum CyclePaie {
  HEBDOMADAIRE
  QUINZAINE
  MENSUEL
}

enum TypeValidateur {
  INTERNE
  MAITRE_OEUVRE
  MAITRE_OUVRAGE
}

enum StatutJalon {
  ATTENTE
  VALIDE
  ABANDONNE
}

enum RoleFonctionnel {
  CONDUCTEUR
  CHARGE_ETUDES
  CHEF_CHANTIER
  CHEF_EQUIPE
}

model Direction {
  id           String  @id @default(cuid())
  code         String  @unique // DG, DFC, DT, DAR
  libelle      String
  ordre        Int     @default(0)
  reserveAdmin Boolean @default(false) // création/affectation réservée

  services Service[]
  postes   Poste[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@map("directions")
}

model Service {
  id      String @id @default(cuid())
  code    String @unique
  libelle String
  ordre   Int    @default(0)

  directionId String
  direction   Direction @relation(fields: [directionId], references: [id])

  postes Poste[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@index([directionId])
  @@map("services")
}

model Poste {
  id      String             @id @default(cuid())
  code    String             @unique
  libelle String
  niveau  NiveauHierarchique

  /// Rattachement à un service. NULL = poste transverse à la direction
  /// (ex: chaîne chantier DT, sans service spécifique)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  directionId String
  direction   Direction @relation(fields: [directionId], references: [id])

  /// Supérieur par défaut au niveau du poste. Sert à proposer
  /// automatiquement le bon supérieur lors d'une affectation.
  /// Affectation.superieurId reste le lien réel, personne par personne,
  /// et peut s'en écarter.
  superieurPosteId String?
  superieurPoste   Poste?  @relation("HierarchiePoste", fields: [superieurPosteId], references: [id])
  subordonnesPoste Poste[] @relation("HierarchiePoste")

  reserveAdmin     Boolean @default(false)
  /// Un seul titulaire actif à la fois (postes de direction)
  titulaireUnique  Boolean @default(false)
  /// Ouvre un compteur de congés annuels (DECISIONS.md)
  ouvreDroitConges Boolean @default(true)

  affectations Affectation[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@index([directionId])
  @@index([serviceId])
  @@map("postes")
}

// =====================================================================
// MODÈLES M2 — EMPLOYÉS
// =====================================================================

/// Table de référence des nationalités. Modifiable via création inline.
model Nationalite {
  id      String @id @default(cuid())
  libelle String @unique

  employes Employe[]

  @@map("nationalites")
}

/// Employé ITA. Deux dossiers distincts selon typeMainOeuvre :
/// - PERMANENT : dossier complet (~40 champs)
/// - JOURNALIER : 4 champs seulement (décision A-12)
model Employe {
  id String @id @default(cuid())

  /// Format ITA-AAAA-NNNN. Généré par le serveur, conservé à vie.
  matricule String @unique

  typeMainOeuvre TypeMainOeuvre

  // --- Identité (obligatoire pour tous) ---
  nom    String
  prenom String
  sexe   Sexe?

  // --- Identité (PERMANENT uniquement) ---
  dateNaissance    DateTime?            @db.Date
  lieuNaissance    String?
  nationaliteId    String?
  nationalite      Nationalite?         @relation(fields: [nationaliteId], references: [id])
  situationMatrimoniale SituationMatrimoniale?
  nombreEnfants    Int?                 @default(0)

  /// Donnée SENSIBLE. Unique parmi les permanents actifs (non archivés).
  numeroCnps String? @unique

  // --- Contact ---
  telephone          String // Obligatoire pour tous
  telephoneSecondaire String?
  email              String?
  /// Donnée SENSIBLE
  adresse            String?

  // --- Contact d'urgence (PERMANENT) ---
  urgenceNom String?
  urgenceTel String?

  // --- Paiement ---
  /// Donnée SENSIBLE. Pour JOURNALIER, obligatoire si modePaiement = WAVE.
  /// Double confirmation obligatoire. Toute modification journalisée.
  numeroWave  String?
  modePaiement ModePaiement?

  /// RIB pour permanents. Donnée SENSIBLE.
  rib String?

  // --- Référence interne (optionnel) ---
  /// Code utilisé avant ITA Manager (ex: "OP-052", "DG-001").
  referenceInterne String?

  // --- Relations ---
  affectations         Affectation[]
  contrats             Contrat[]
  documents            DocumentEmploye[]
  derogationsSalariales DerogationSalariale[]

  /// Hiérarchie employé : subordonnes directs
  subordonnesEmploye Affectation[] @relation("HierarchieEmploye")

  /// Lien vers le profil applicatif (null si l'employé n'a pas de compte)
  profil Profil?

  /// M3 — Congés et permissions
  absences           Absence[]
  soldeCongés        SoldeConge[]
  delegationsMandant Delegation[] @relation("Mandant")
  delegationsDeleg   Delegation[] @relation("Delegataire")

  /// M12 — Présences bureau
  codePointage    CodePointage?
  pointagesBureau PointageBureau[]

  /// M5 — Projets (chaîne fonctionnelle)
  affectationsChantier AffectationChantier[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  /// Archivage, jamais suppression. Motif stocké dans JournalEvenement.
  archiveLe DateTime?

  @@index([matricule])
  @@index([typeMainOeuvre])
  @@index([nationaliteId])
  @@map("employes")
}

/// Promouvoir Profil.employeId en vraie relation
model Profil {
  /// UUID identique à auth.users.id (Supabase)
  id String @id @db.Uuid

  email        String    @unique
  actif        Boolean   @default(true)
  derniereConn DateTime?

  /// Rattachement à un employé. `null` pour les comptes techniques
  /// (ex. Super Admin, hors organigramme).
  employeId String? @unique
  employe   Employe? @relation(fields: [employeId], references: [id])

  /// Délégation de pouvoir (décision B-03)
  delegataireId   String?   @db.Uuid
  delegationDebut DateTime? @db.Date
  delegationFin   DateTime? @db.Date

  roles          ProfilRole[]
  evenements     JournalEvenement[]
  codesSecoursMfa CodeSecoursMfa[]

  creeLe    DateTime  @default(now())
  modifieLe DateTime  @updatedAt
  archiveLe DateTime?

  @@map("profils")
}

/// Affectation d'un employé à un poste. Un employé peut avoir plusieurs
/// affectations successives (historique). Une seule active à la fois.
model Affectation {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  posteId String
  poste   Poste  @relation(fields: [posteId], references: [id])

  /// Supérieur hiérarchique RÉEL (personne par personne).
  /// Proposé depuis Poste.superieurPosteId, mais modifiable.
  /// Obligatoire sauf pour le Directeur Général (décision B-09).
  superieurId String?
  superieur   Employe?  @relation("HierarchieEmploye", fields: [superieurId], references: [id])

  dateDebut DateTime @db.Date
  dateFin   DateTime? @db.Date

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([employeId])
  @@index([posteId])
  @@index([superieurId])
  @@map("affectations")
}

/// Contrat de travail. Jamais modifié après signature : toute modification
/// donne lieu à un Avenant (historique lisible).
model Contrat {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  typeContrat TypeContrat
  dateDebut   DateTime    @db.Date
  /// Obligatoire pour CDD et STAGE, null pour CDI et INTERIM
  dateFin     DateTime?   @db.Date

  /// Salaire mensuel brut (PERMANENT) ou taux journalier (JOURNALIER).
  /// Donnée SENSIBLE. Si hors grille, déclenche DerogationSalariale.
  salaire Decimal @db.Decimal(10, 2)

  /// Contrat signé déposé dans DocumentEmploye
  signe Boolean @default(false)

  avenants Avenant[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([employeId])
  @@index([typeContrat])
  @@index([dateFin]) // Pour alertes CDD
  @@map("contrats")
}

/// Avenant à un contrat (changement de poste, salaire, durée).
/// Jamais de réécriture du contrat : l'historique doit rester lisible.
model Avenant {
  id String @id @default(cuid())

  contratId String
  contrat   Contrat @relation(fields: [contratId], references: [id])

  motif         String // "Changement de poste", "Augmentation salariale"
  dateEffet     DateTime @db.Date
  nouveauSalaire Decimal? @db.Decimal(10, 2)
  nouvelleDateFin DateTime? @db.Date

  creeLe DateTime @default(now())

  @@index([contratId])
  @@map("avenants")
}

/// Document justificatif (pièce d'identité, diplôme, etc.).
/// Stocké dans Supabase Storage (bucket privé). Accès par URL signée courte.
model DocumentEmploye {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// Type de document : PIECE_IDENTITE, EXTRAIT_NAISSANCE, DIPLOME,
  /// CERTIFICAT_TRAVAIL, ATTESTATION_CNPS, VISITE_MEDICALE, CONTRAT_SIGNE, PHOTO
  typeDocument String

  /// Nom original du fichier
  nomFichier String
  /// Chemin dans le bucket Supabase Storage
  cheminStorage String

  /// Taille en octets
  taille Int

  /// Les pièces médicales sont de classification PARTICULIER.
  /// Accès restreint à la DRH, consultation journalisée.
  estMedical Boolean @default(false)

  deposeParId String @db.Uuid
  deposeLe    DateTime @default(now())

  @@index([employeId])
  @@index([typeDocument])
  @@map("documents_employes")
}

/// Dérogation salariale (salaire hors de la fourchette du niveau).
/// Circuit de validation : RH demande → DFC statue.
/// Tant que EN_ATTENTE, l'employé est exclu des exports de paie.
model DerogationSalariale {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  montant Decimal @db.Decimal(10, 2)
  /// Fourchette du niveau au moment de la demande
  niveauMin Decimal @db.Decimal(10, 2)
  niveauMax Decimal @db.Decimal(10, 2)

  /// Motif substantiel (≥ 40 caractères). Ex: "Recrutement en tension,
  /// seul candidat titulaire du CACES 4 et de l'habilitation soudure PE."
  motif String @db.Text

  statut StatutDerogation @default(EN_ATTENTE)

  demandeParId String   @db.Uuid
  demandeLe    DateTime @default(now())

  /// Décision de la Direction Financière
  decideParId    String?   @db.Uuid
  decideLe       DateTime?
  commentaire    String?   @db.Text

  @@index([employeId])
  @@index([statut])
  @@map("derogations_salariales")
}

// =====================================================================
// CONGÉS ET PERMISSIONS — M3
// =====================================================================

enum StatutAbsence {
  BROUILLON    // Demande en cours de rédaction
  ATTENTE_N1   // Soumise, en attente de décision du supérieur
  ATTENTE_RH   // Validée par N+1, en attente de décision RH
  VALIDEE      // Validée par RH, absence accordée
  REFUSEE      // Refusée (soit par N+1, soit par RH)
  ANNULEE      // Annulée par le demandeur ou RH
}

enum TypeMouvementSolde {
  DOTATION      // Dotation annuelle ou mensuelle acquise
  MAJORATION    // Majoration d'ancienneté
  REPORT        // Report du solde de l'exercice précédent
  CONSOMMATION  // Jours pris pour une absence validée
}

/// Types d'absence référentiels. 4 types de base créés au seed.
model TypeAbsence {
  id String @id @default(cuid())

  /// Ex: "Congé annuel", "Congé maladie", "Permission exceptionnelle"
  libelle String @unique

  /// Si true, les jours sont décomptés du solde de congés
  decompte Boolean @default(true)

  /// Si true, une pièce justificative est requise
  pieceRequise Boolean @default(false)

  /// Si true, la pièce est de classification PARTICULIER (accès DRH seule)
  /// Utilisé pour les certificats médicaux.
  pieceClassification Boolean @default(false)

  actif Boolean @default(true)

  absences Absence[]

  @@map("types_absence")
}

/// Demande d'absence (congé ou permission). Circuit à 2 étapes.
model Absence {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  typeAbsenceId String
  typeAbsence   TypeAbsence @relation(fields: [typeAbsenceId], references: [id])

  /// Bornes incluses
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date

  /// Calculé (jamais saisi) — exclut fériés et non-ouvrables
  nombreJours Decimal @db.Decimal(5, 1)

  statut StatutAbsence @default(BROUILLON)

  /// Motif de la demande (facultatif)
  motif String? @db.Text

  /// FIGÉ À LA SOUMISSION (décision 7.2)
  /// Si l'employé change de service, la demande reste chez ce supérieur.
  superieurId String?

  /// Décision du supérieur (N+1)
  decisionN1      String? // "VALIDE" | "REFUSE"
  decisionN1Le    DateTime?
  decisionN1ParId String? @db.Uuid
  motifRefusN1    String? @db.Text

  /// Décision de la Direction RH
  decisionRH      String? // "VALIDE" | "REFUSE"
  decisionRHLe    DateTime?
  decisionRHParId String? @db.Uuid
  motifRefusRH    String? @db.Text

  /// Pièce justificative (certificat médical, convocation, etc.)
  /// Référence vers DocumentEmploye.
  pieceId String?

  creeLe    DateTime @default(now())
  soumieLe  DateTime?
  annuleeLe DateTime?

  @@index([employeId])
  @@index([statut])
  @@index([superieurId])
  @@map("absences")
}

/// Mouvements de solde de congés (JAMAIS un total stocké — voir §6.1).
/// Le solde se calcule en sommant les mouvements.
model SoldeConge {
  id String @id @default(cuid())

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// Exercice concerné (année civile)
  exercice Int

  typeMouvement TypeMouvementSolde

  /// Nombre de jours (positif pour dotation/majoration/report, négatif pour consommation)
  jours Decimal @db.Decimal(5, 1)

  /// Référence vers l'absence si typeMouvement = CONSOMMATION
  absenceId String?

  /// Commentaire libre (ex: "Dotation 2026", "Majoration 10 ans ancienneté")
  commentaire String?

  enregistreLe  DateTime @default(now())
  enregistreParId String @db.Uuid

  @@index([employeId])
  @@index([exercice])
  @@map("soldes_conges")
}

/// Délégation nommée (décision B-03). Un responsable désigne son délégataire
/// à l'avance pour une période. Pendant celle-ci, les demandes lui parviennent aussi.
model Delegation {
  id String @id @default(cuid())

  /// Le mandant (celui qui délègue)
  mandantId String
  mandant   Employe @relation("Mandant", fields: [mandantId], references: [id])

  /// Le délégataire (celui qui reçoit la délégation)
  delegataireId String
  delegataire   Employe @relation("Delegataire", fields: [delegataireId], references: [id])

  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date

  /// Si false, la délégation est suspendue sans être supprimée
  actif Boolean @default(true)

  creeLe DateTime @default(now())

  @@index([mandantId])
  @@index([delegataireId])
  @@index([actif])
  @@map("delegations")
}

/// Paramètres des règles de congés (dotation, report, etc.).
/// Clé-valeur pour flexibilité. Modifiable uniquement par ADMIN.
model RegleConge {
  id String @id @default(cuid())

  /// Ex: "dotation.annuelle", "report.plafond", "majoration.10ans"
  cle String @unique

  /// Valeur stockée sous forme texte (à parser selon la clé)
  valeur String

  /// Description affichée dans l'interface d'administration
  description String? @db.Text

  modifieLe  DateTime @default(now())
  modifieParId String @db.Uuid

  @@map("regles_conges")
}

/// Jours fériés. Fixes (ex: 1er mai) ou mobiles (ex: Aïd el-Fitr).
/// Les fériés musulmans suivent le calendrier lunaire et doivent être
/// saisis manuellement chaque année (voir §1.3).
model JourFerie {
  id String @id @default(cuid())

  date    DateTime @db.Date
  libelle String

  /// Si true, date mobile (calculée ou saisie chaque année)
  mobile Boolean @default(false)

  creeLe DateTime @default(now())

  @@unique([date])
  @@index([date])
  @@map("jours_feries")
}

// =====================================================================
// APPELS D'OFFRES — M9
// =====================================================================

enum StatutAppelOffres {
  VEILLE       // Repéré, pas encore arbitré
  GO           // DG a validé la participation
  ABANDONNE    // No-go ou dépassé sans soumission
  CONSTITUTION // Dossier en cours de constitution
  SOUMIS       // Déposé
  GAGNE        // Attributaire
  PERDU        // Concurrent attributaire
}

enum TypeMarche {
  PUBLIC
  PRIVE
  INTERNATIONAL
}

model AppelOffres {
  id String @id @default(cuid())

  reference       String  // Référence de l'AO
  maitreOuvrage   String  // Nom du maître d'ouvrage
  objet           String  @db.Text
  montantEstime   Decimal? @db.Decimal(15, 2)
  dateLimiteDepot DateTime
  lieu            String?
  typeMarche      TypeMarche @default(PUBLIC)

  statut StatutAppelOffres @default(VEILLE)

  /// Go/No-go du Directeur Général
  goNoGoDecidePar   String?   @db.Uuid
  goNoGoDecideLe    DateTime?
  goNoGoMotif       String?   @db.Text

  /// Résultat
  montantAttribution Decimal? @db.Decimal(15, 2)
  attributaire       String?  // Nom du concurrent si perdu
  dateNotification   DateTime?

  /// Relations
  pieces      PieceAO[]
  concurrents ConcurrentAO[]

  creePar   String   @db.Uuid
  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([statut])
  @@index([dateLimiteDepot])
  @@map("appels_offres")
}

model PieceAO {
  id            String @id @default(cuid())
  appelOffresId String
  appelOffres   AppelOffres @relation(fields: [appelOffresId], references: [id], onDelete: Cascade)

  libelle       String
  obligatoire   Boolean @default(false)
  fichierUrl    String?
  deposeLe      DateTime?

  @@index([appelOffresId])
  @@map("pieces_ao")
}

model ConcurrentAO {
  id            String @id @default(cuid())
  appelOffresId String
  appelOffres   AppelOffres @relation(fields: [appelOffresId], references: [id], onDelete: Cascade)

  nom           String
  montantSoumis Decimal? @db.Decimal(15, 2)
  remarque      String?  @db.Text

  @@index([appelOffresId])
  @@map("concurrents_ao")
}

// =====================================================================
// MODÈLES M12 — PRÉSENCES BUREAU
// =====================================================================

/// Appareil autorisé à accéder à la borne de pointage.
/// Jeton unique, généré à l'installation, révocable depuis l'administration.
model AppareilBorne {
  id String @id @default(cuid())

  /// Jeton secret unique, généré à la création, haché en base.
  /// Présenté par l'appareil à chaque requête à /borne.
  jetonHash String @unique

  libelle       String // Ex: "Tablette accueil - Rez-de-chaussée"
  emplacement   String? // Ex: "Accueil principal"

  actif         Boolean  @default(true)
  dernierAcces  DateTime?

  creePar   String   @db.Uuid
  creeLe    DateTime @default(now())
  revoqueLe DateTime?
  revoquePar String? @db.Uuid

  @@map("appareils_borne")
}

/// Code de pointage à 5 chiffres pour un employé.
/// Haché en base, jamais stocké en clair.
/// Distinct du mot de passe applicatif.
model CodePointage {
  id        String @id @default(cuid())
  employeId String @unique

  employe Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)

  /// Code haché (bcrypt). Le code en clair n'est jamais stocké.
  codeHash String

  /// Régénération : l'ancien code devient invalide.
  genereParId String   @db.Uuid
  genereLe    DateTime @default(now())

  @@index([employeId])
  @@map("codes_pointage")
}

enum TypePointage {
  ARRIVEE
  DEPART
}

/// Pointage bureau d'un employé.
/// Append-only : une correction ajoute une ligne, ne modifie pas l'existante.
model PointageBureau {
  id        String @id @default(cuid())
  employeId String

  employe Employe @relation(fields: [employeId], references: [id])

  type       TypePointage
  horodatage DateTime     @default(now())

  /// Si correction manuelle par DRH
  estCorrection Boolean  @default(false)
  corrigePar    String?  @db.Uuid
  motif         String?  @db.Text

  /// Anomalie : 3e pointage le même jour
  estAnomalie Boolean @default(false)

  @@index([employeId])
  @@index([horodatage])
  @@map("pointages_bureau")
}

// ====================================================================
// M4 — RÉMUNÉRATION
// ====================================================================

/// Version de la grille salariale — immuable une fois publiée
model GrilleSalariale {
  id String @id @default(cuid())

  /// V1, V2, V3…
  version Int

  /// BROUILLON, PUBLIEE, ARCHIVEE
  statut StatutGrille @default(BROUILLON)

  /// Date d'effet — première paie concernée
  /// Ex: v2 votée le 15 mars, dateEffet = 2026-04-01 → appliquée à la paie d'avril
  dateEffet DateTime?

  /// Date de vote DFC — obligatoire pour publier
  valideLe DateTime?
  validePar String? @db.Uuid

  echelons EchelonGrille[]

  creeLe DateTime @default(now())
  creePar String @db.Uuid

  @@unique([version])
  @@map("grilles_salariales")
}

/// Échelon dans une version de grille (un par niveau hiérarchique)
model EchelonGrille {
  id String @id @default(cuid())

  grilleId String
  grille   GrilleSalariale @relation(fields: [grilleId], references: [id], onDelete: Cascade)

  /// DIRECTION, CADRE, SUPPORT, OPERATIONNEL
  niveau NiveauHierarchique

  /// Fourchette en FCFA
  min Decimal @db.Decimal(12, 0)
  med Decimal @db.Decimal(12, 0)
  max Decimal @db.Decimal(12, 0)

  @@unique([grilleId, niveau])
  @@map("echelons_grille")
}

// ====================================================================
// M5 — PROJETS ET PLANNING
// ====================================================================

/// Projet (chantier)
model Projet {
  id String @id @default(cuid())

  /// Code unique: CH-AAAA-NNN (ex: CH-2026-001)
  code String @unique
  nom  String
  description String?

  /// BROUILLON, OUVERT, EN_COURS, SUSPENDU, CLOTURE
  statut StatutProjet @default(BROUILLON)

  /// Maitre d'ouvrage
  maitreOuvrage String?

  /// Montant du marché en FCFA
  montantMarche Decimal? @db.Decimal(15, 2)

  /// Dates prévisionnelles
  dateDebut DateTime?
  dateFin   DateTime?

  /// Cycle de paie pour les journaliers sur ce projet
  /// HEBDOMADAIRE, QUINZAINE, MENSUEL
  /// Figé après la première période de paie
  cyclePaie CyclePaie?

  /// Relations
  taches        Tache[]
  jalons        Jalon[]
  affectations  AffectationChantier[]
  lieuLivraison LieuLivraison?

  creeLe  DateTime @default(now())
  creePar String   @db.Uuid

  @@map("projets")
}

/// Tâche dans un projet (pour Gantt)
model Tache {
  id String @id @default(cuid())

  projetId String
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  libelle     String
  description String?

  dateDebut DateTime
  dateFin   DateTime

  /// Avancement planifié (0-100)
  avancementPlanifie Int @default(0)

  /// Avancement constaté depuis relevés (0-100)
  avancementConstate Int?

  /// Tâche prédécesseur (dépendance)
  predecesseurId String?
  predecesseur   Tache?  @relation("Dependances", fields: [predecesseurId], references: [id], onDelete: SetNull)
  successeurs    Tache[] @relation("Dependances")

  creeLe DateTime @default(now())

  @@map("taches")
}

/// Jalon (milestone) - validé en interne ou par tiers externe
model Jalon {
  id String @id @default(cuid())

  projetId String
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  libelle            String
  description        String?
  datePrevisionnelle DateTime

  /// INTERNE (DT/DG), MAITRE_OEUVRE, MAITRE_OUVRAGE
  typeValidateur TypeValidateur

  /// Nom du validateur externe si applicable
  validateurExterne String?

  /// ATTENTE, VALIDE, ABANDONNE
  statut StatutJalon @default(ATTENTE)

  /// Pièce justificative obligatoire pour validation externe
  pieceId String? @db.Uuid

  valideLe DateTime?
  /// Auteur de la saisie (distinct du validateur externe)
  validePar String? @db.Uuid

  creeLe DateTime @default(now())

  @@map("jalons")
}

/// Affectation d'employé à un chantier (chaîne fonctionnelle)
/// DISTINCT de Affectation (chaîne hiérarchique)
model AffectationChantier {
  id String @id @default(cuid())

  projetId String
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  employeId String
  employe   Employe @relation(fields: [employeId], references: [id])

  /// Rôle sur le chantier: CONDUCTEUR, CHEF_CHANTIER, CHEF_EQUIPE, OPERATEUR
  roleFonctionnel RoleFonctionnel

  dateDebut DateTime
  dateFin   DateTime?

  creeLe  DateTime @default(now())
  creePar String   @db.Uuid

  @@map("affectations_chantier")
}

/// Lieu de livraison — créé automatiquement à l'ouverture du projet
model LieuLivraison {
  id String @id @default(cuid())

  /// Lien 1:1 avec Projet
  projetId String? @unique
  projet   Projet? @relation(fields: [projetId], references: [id])

  libelle     String
  adresse     String?
  coordonnees String? /// GPS ou autre

  creeLe  DateTime @default(now())
  creePar String   @db.Uuid

  @@map("lieux_livraison")
}

