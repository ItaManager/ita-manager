// ═══════════════════════════════════════════════════════════════════════

enum MoyenTransport {
  VEHICULE_ITA      /// Un matériel de M13
  TRANSPORT_COMMUN
  VEHICULE_PERSONNEL
  AVION
  AUTRE
}

enum EtapeRefus {
  N1
  RH
}

enum MomentFrais {
